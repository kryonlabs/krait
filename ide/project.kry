#module "ide.project"
#import "kryon.h"
state :: #import "ide/state"
ed :: #import "ide/editor"

kry_fs_realpath :: (path: const char*, out: char*, cap: int) -> int #extern
kry_fs_exists :: (path: const char*) -> int #extern
kry_fs_stat :: (path: const char*, out: KryFileStat*) -> int #extern
krait_recent_add :: (path: const char*) #extern

#enum {
    PROJECT_OK,
    PROJECT_MISSING,
}

#global

#private

path_basename :: (dst: char*, dst_size: int, path: const char*) {
    base := path
    p := path
    while *p != 0 {
        if *p == '/' {
            base = p + 1
        }
        p = p + 1
    }
    snprintf(dst, dst_size, "%s", base)
}

path_dirname :: (dst: char*, dst_size: int, path: const char*) {
    last_slash: const char* = NULL
    p := path
    while *p != 0 {
        if *p == '/' {
            last_slash = p
        }
        p = p + 1
    }
    if last_slash == NULL {
        snprintf(dst, dst_size, "%s", ".")
        return
    }
    len: int = last_slash - path
    if len <= 0 {
        snprintf(dst, dst_size, "%s", "/")
        return
    }
    if len >= dst_size {
        len = dst_size - 1
    }
    snprintf(dst, len + 1, "%s", path)
}

project_open :: (st: state.IdeState*, path: const char*) -> int {
    resolved: [1024] char
    project_path: [1024] char
    selected_file: [256] char
    fst: KryFileStat
    if kry_fs_exists(path) == 0 {
        state.project_set_status(st, "Project path does not exist")
        return PROJECT_MISSING
    }
    if kry_fs_realpath(path, resolved, sizeof(resolved)) == 0 {
        snprintf(resolved, sizeof(resolved), "%s", path)
    }
    snprintf(project_path, sizeof(project_path), "%s", resolved)
    selected_file[0] = 0
    if kry_fs_stat(resolved, &fst) != 0 && fst.is_dir == 0 {
        path_basename(selected_file, sizeof(selected_file), resolved)
        path_dirname(project_path, sizeof(project_path), resolved)
    }
    snprintf(st->project.path, sizeof(st->project.path), "%s", project_path)
    path_basename(st->project.name, sizeof(st->project.name), project_path)
    st->project.loaded = 1
    st->view = state.IDE_VIEW_PROJECT
    st->entry_count = kry_fs_list_dir(project_path, &st->entries[0], 256)
    krait_recent_add(project_path)
    if selected_file[0] != 0 {
        ed.editor_open(st, selected_file)
    }
    state.project_set_status(st, st->project.name)
    return PROJECT_OK
}
