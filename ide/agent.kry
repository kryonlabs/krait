#module "ide.agent"
#import "kryon.h"
#import <string.h>
state :: #import "ide/state"
tree :: #import "ide/tree"
ed :: #import "ide/editor"
prob :: #import "ide/problems"
con :: #import "ide/console"

krait_agent_consume_console :: () -> const char* #extern
krait_agent_clear_console :: () #extern
krait_agent_streaming_text :: () -> const char* #extern
krait_agent_compile_errors :: () -> const char* #extern
krait_agent_bind :: (project_dir: const char*) #extern
krait_agent_count :: () -> int #extern
krait_agent_kind :: (index: int) -> int #extern
krait_agent_text :: (index: int) -> const char* #extern
krait_agent_status_text :: () -> const char* #extern
krait_agent_busy :: () -> int #extern
krait_agent_files_changed :: () -> int #extern
krait_agent_written_count :: () -> int #extern
krait_agent_written_path :: (index: int) -> const char* #extern
krait_agent_can_revert :: () -> int #extern
krait_agent_revert :: () -> int #extern
krait_agent_send :: (text: const char*) -> int #extern
krait_agent_stop :: () #extern
krait_agent_clear :: () #extern
krait_agent_poll :: () -> int #extern

agent_input :: [2048] char #global
agent_input_cursor :: int #global
agent_input_focused :: int #global
agent_scroll :: int #global
agent_bound :: int #global
agent_expanded :: int #global

# Word-wrap a message for the transcript: count the physical lines that
# fit wrap_w pixels, hard-splitting long unbroken runs.
agent_wrap_text :: (text: const char*, wrap_w: int, font: int, max_lines: int) -> int {
    total := 0
    i := 0
    line_w := 0
    while text[i] != 0 {
        word_start := i
        while text[i] != 0 && text[i] != ' ' && text[i] != 10 {
            i = i + 1
        }
        seg: [512] char
        seg_len := i - word_start
        if seg_len > 511 {
            seg_len = 511
        }
        memcpy(seg, text + word_start, seg_len)
        seg[seg_len] = 0
        seg_w := MeasureUIText(seg, font)
        if line_w > 0 && line_w + seg_w + font > wrap_w {
            total = total + 1
            line_w = 0
            if total >= max_lines {
                return total
            }
        }
        if seg_w > wrap_w {
            total = total + (seg_w + wrap_w - 1) / wrap_w
            line_w = seg_w % wrap_w
            if total >= max_lines {
                return max_lines
            }
        } else {
            line_w = line_w + seg_w + font
        }
        if text[i] == 10 {
            total = total + 1
            line_w = 0
            if total >= max_lines {
                return total
            }
        }
        if text[i] != 0 {
            i = i + 1
        }
    }
    return total + 1
}

# Render one wrapped line: same walk as agent_wrap_text, stopping at the
# requested row.
agent_wrapped_line :: (text: const char*, wrap_w: int, font: int, max_lines: int,
                       want: int, dst: char*, dst_size: int) {
    dst[0] = 0
    total := 0
    i := 0
    line_w := 0
    start := -1
    while text[i] != 0 {
        word_start := i
        while text[i] != 0 && text[i] != ' ' && text[i] != 10 {
            i = i + 1
        }
        seg: [512] char
        seg_len := i - word_start
        if seg_len > 511 {
            seg_len = 511
        }
        memcpy(seg, text + word_start, seg_len)
        seg[seg_len] = 0
        seg_w := MeasureUIText(seg, font)
        if line_w > 0 && line_w + seg_w + font > wrap_w {
            if total == want {
                return
            }
            total = total + 1
            line_w = 0
            start = -1
        }
        if total == want {
            if start < 0 {
                start = word_start
            }
            take := i - start
            if take > dst_size - 1 {
                take = dst_size - 1
            }
            memcpy(dst, text + start, take)
            dst[take] = 0
        }
        if seg_w > wrap_w {
            if total == want {
                return
            }
            total = total + 1
            line_w = seg_w % wrap_w
        } else {
            line_w = line_w + seg_w + font
        }
        if text[i] == 10 {
            if total == want {
                return
            }
            total = total + 1
            line_w = 0
            start = -1
        }
        if text[i] != 0 {
            i = i + 1
        }
    }
    if total == want && start >= 0 {
        take := i - start
        if take > dst_size - 1 {
            take = dst_size - 1
        }
        memcpy(dst, text + start, take)
        dst[take] = 0
    }
}

agent_bind :: (st: state.IdeState*) {
    if agent_bound != 0 {
        return
    }
    if st->project.loaded == 0 {
        return
    }
    krait_agent_bind(st->project.path)
    agent_bound = 1
}

draw_agent :: (bounds: Rectangle, st: state.IdeState*) {
    agent_bind(st)
    krait_agent_poll()
    if krait_agent_files_changed() != 0 {
        tree.refresh_tree(st)
        i := 0
        while i < krait_agent_written_count() {
            ed.editor_reload_if_open(st, krait_agent_written_path(i))
            i = i + 1
        }
    }
    agent_route_problems(st)
    agent_mirror_console(st)
    if ed.mod_key_down() && IsKeyPressed(KEY_L) {
        if agent_input_focused == 0 {
            agent_reset(st)
        }
    }
    DrawRectangleRec(bounds, GetThemeBackground())
    pad := ScaleUIPx(10)
    row_h := ScaleUIPx(32)
    input_y := (int)bounds.y + (int)bounds.height - row_h - pad
    status := krait_agent_status_text()
    busy := krait_agent_busy()
    transcript_h := (float)(input_y - (int)bounds.y)
    if strlen(status) > 0 {
        transcript_h = transcript_h - (float)ScaleUIPx(22)
    }
    transcript := (Rectangle){bounds.x, bounds.y, bounds.width, transcript_h}
    draw_transcript(transcript, busy)
    if strlen(status) > 0 {
        DrawUIText(status, (int)bounds.x + pad,
                   input_y - ScaleUIPx(20), ScaleUIPx(12), GetThemeLink())
    }

    style := (UITextInputStyle){
        GetThemeSurface(), GetThemeButton(), GetThemeLink(), GetThemeText(),
        GetThemeText(), 0, ScaleUIPx(10), ScaleUIPx(8)
    }
    send_w := ScaleUIPx(64)
    stop_w := ScaleUIPx(58)
    field_w := bounds.width - (float)(pad * 2 + send_w + stop_w + ScaleUIPx(12))
    DrawUITextField((TextFieldProps){
        (Rectangle){bounds.x + (float)pad, (float)input_y,
                    field_w, (float)row_h},
        agent_input, sizeof(agent_input),
        &agent_input_cursor, &agent_input_focused,
        sizeof(agent_input) - 1, ScaleUIPx(13), 7601,
        style, (UITextInputFilter){0}, NULL, NULL
    })
    if strlen(agent_input) > 0 && busy == 0 {
        if DrawUIGenericButton((int)bounds.x + pad + (int)field_w + ScaleUIPx(6),
                               input_y, send_w, row_h, "Send",
                               UI_BUTTON_STYLE_PRIMARY, 0, NULL) {
            agent_send_input()
        }
    }
    if krait_agent_can_revert() != 0 {
        rev_w := ScaleUIPx(70)
        if DrawUIGenericButton((int)bounds.x + (int)bounds.width - pad -
                               stop_w - ScaleUIPx(6) - rev_w,
                               input_y, rev_w, row_h, "Revert",
                               UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
            krait_agent_revert()
        }
    }
    if DrawUIGenericButton((int)bounds.x + (int)bounds.width - pad - stop_w,
                           input_y, stop_w, row_h, busy != 0 ? "Stop" : "Clear",
                           UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        if busy != 0 {
            krait_agent_stop()
        } else {
            agent_reset(st)
        }
    }
    if agent_input_focused != 0 && IsKeyPressed(KEY_ENTER) && busy == 0 {
        agent_send_input()
    }
}

/* Run-tool output mirrors into the Console pane's live terminal. */
agent_mirror_console :: (st: state.IdeState*) {
    pending := krait_agent_consume_console()
    if strlen(pending) > 0 {
        con.console_feed(st, pending)
        krait_agent_clear_console()
    }
}

/* Compile failures land in the Problems pane, same as studio builds. */
agent_route_problems :: (st: state.IdeState*) {
    errors := krait_agent_compile_errors()
    if strlen(errors) == 0 {
        return
    }
    st->diagnostic_count = 0
    line: [512] char
    i := 0
    n := 0
    while errors[i] != 0 && st->diagnostic_count < 64 {
        if errors[i] == 10 {
            line[n] = 0
            if n > 0 {
                prob.parse_diagnostic_line(st, line)
            }
            n = 0
        } else {
            if n < 511 {
                line[n] = errors[i]
                n = n + 1
            }
        }
        i = i + 1
    }
}

agent_reset :: (st: state.IdeState*) {
    krait_agent_clear()
    agent_input[0] = 0
    agent_input_cursor = 0
    agent_bound = 0
    agent_bind(st)
}

agent_send_input :: () {
    krait_agent_send(agent_input)
    agent_input[0] = 0
    agent_input_cursor = 0
}

draw_transcript :: (bounds: Rectangle, busy: int) {
    count := krait_agent_count()
    pad := ScaleUIPx(12)
    line_h := ScaleUIPx(17)
    content_h := count * (line_h * 3 + ScaleUIPx(14))
    max_scroll := content_h - (int)bounds.height
    if max_scroll < 0 {
        max_scroll = 0
    }
    if agent_scroll > max_scroll {
        agent_scroll = max_scroll
    }
    if agent_scroll < 0 {
        agent_scroll = 0
    }
    if max_scroll > 0 {
        wheel := (int)(GetMouseWheelMove() * (float)line_h * 3.0)
        agent_scroll = agent_scroll + wheel
        if agent_scroll > max_scroll {
            agent_scroll = max_scroll
        }
        if agent_scroll < 0 {
            agent_scroll = 0
        }
    }
    if count == 0 {
        hint := "Ask the agent to change the project: describe what you want,"
        hint2 := "it reads, edits, compiles, and reports back."
        DrawUIText(hint, (int)bounds.x + pad, (int)bounds.y + ScaleUIPx(14),
                   ScaleUIPx(13), GetThemeIcon())
        DrawUIText(hint2, (int)bounds.x + pad,
                   (int)bounds.y + ScaleUIPx(34), ScaleUIPx(13),
                   GetThemeIcon())
        return
    }
    BeginScissorMode((int)bounds.x, (int)bounds.y, (int)bounds.width,
                     (int)bounds.height)
    i := 0
    y := (int)bounds.y + ScaleUIPx(8) - agent_scroll
    while i < count {
        kind := krait_agent_kind(i)
        text := krait_agent_text(i)
        label := "you"
        color := GetThemeText()
        if kind == 1 {
            label = "agent"
        } else if kind == 2 {
            label = "tools"
        } else if kind == 4 {
            label = "actions"
        } else if kind == 3 {
            label = "error"
        }
        head: [64] char
        snprintf(head, sizeof(head), "%s:", label)
        DrawUIText(head, (int)bounds.x + pad, y, ScaleUIPx(11),
                   GetThemeLink())
        wrap_w := (int)bounds.width - pad * 2 - ScaleUIPx(16)
        max_lines := 3
        if agent_expanded == i {
            max_lines = 60
        }
        lines := agent_wrap_text(text, wrap_w, ScaleUIPx(12), max_lines)
        block := (Rectangle){bounds.x + (float)pad, (float)(y + line_h),
                             bounds.width - (float)(pad * 2),
                             (float)(line_h * lines + ScaleUIPx(8))}
        if kind == 2 || kind == 3 {
            DrawRectangleRec(block, GetThemeSurface())
        }
        hit := CheckCollisionPointRec(GetMousePosition(), block) &&
               IsMouseButtonReleased(MOUSE_BUTTON_LEFT)
        if hit {
            agent_expanded = agent_expanded == i ? -1 : i
        }
        BeginScissorMode((int)block.x, (int)block.y, (int)block.width,
                         (int)block.height)
        row := 0
        while row < lines {
            line_buf: [512] char
            agent_wrapped_line(text, wrap_w, ScaleUIPx(12), max_lines, row,
                               line_buf, sizeof(line_buf))
            DrawUIText(line_buf, (int)block.x + ScaleUIPx(8),
                       (int)block.y + ScaleUIPx(4) + row * line_h,
                       ScaleUIPx(12), color)
            row = row + 1
        }
        EndScissorMode()
        y = y + line_h * (lines + 1) + ScaleUIPx(10)
        i = i + 1
    }
    if busy != 0 {
        live := krait_agent_streaming_text()
        if strlen(live) > 0 {
            DrawUIText("agent:", (int)bounds.x + pad, y, ScaleUIPx(11),
                       GetThemeLink())
            wrap_w2 := (int)bounds.width - pad * 2 - ScaleUIPx(16)
            lines2 := agent_wrap_text(live, wrap_w2, ScaleUIPx(12), 30)
            block2 := (Rectangle){bounds.x + (float)pad,
                                  (float)(y + line_h),
                                  bounds.width - (float)(pad * 2),
                                  (float)(line_h * lines2 + ScaleUIPx(8))}
            BeginScissorMode((int)block2.x, (int)block2.y,
                             (int)block2.width, (int)block2.height)
            row2 := 0
            while row2 < lines2 {
                line_buf2: [512] char
                agent_wrapped_line(live, wrap_w2, ScaleUIPx(12), 30, row2,
                                   line_buf2, sizeof(line_buf2))
                DrawUIText(line_buf2, (int)block2.x + ScaleUIPx(8),
                           (int)block2.y + ScaleUIPx(4) + row2 * line_h,
                           ScaleUIPx(12), GetThemeText())
                row2 = row2 + 1
            }
            EndScissorMode()
        }
    }
    EndScissorMode()
}
