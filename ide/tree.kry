#module "ide.tree"
#import "kryon.h"
state :: #import "ide/state"

#private

#global

entries :: [1024] UICascadingTreeItem #global

build_items :: (st: state.IdeState*) {
    for int i = 0; i < st->entry_count; i++ {
        entries[i].label = st->entries[i].label
        entries[i].depth = st->entries[i].depth
        entries[i].id = st->entries[i].id
        entries[i].is_dir = st->entries[i].is_dir
        entries[i].selectable = 1
    }
}

draw_tree :: (bounds: Rectangle, st: state.IdeState*) {
    if st->entry_count <= 0 {
        return
    }
    build_items(st)
    DrawUICascadingTreeView((UICascadingTreeView){
        bounds, 2000, entries, st->entry_count,
        &st->selected_entry, &st->activated_entry,
        (UICascadingTreeExpansion){
            &st->expanded_entries[0], &st->expanded_count, 256
        },
        &st->tree_scroll, ScaleUIPx(22)
    })
}
