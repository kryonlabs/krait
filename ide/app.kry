#module "ide.app"
#import "kryon.h"
#import "file_dialog.h"
state :: #import "ide/state"
start :: #import "ide/start_page"
proj :: #import "ide/project"
tree :: #import "ide/tree"
ed :: #import "ide/editor"
prev :: #import "ide/preview"
con :: #import "ide/console"
prob :: #import "ide/problems"
srch :: #import "ide/search"

krait_load_ui_font :: () -> int #extern
krait_scaffold_project :: (path: const char*, status: char*, status_size: int) -> int #extern

istate :: state.IdeState #global
project_dialog :: FileDialog #global

apply_studio_theme :: () {
    SetCurrentTheme(THEME_MONO, 1)
}

init :: () {
    krait_load_ui_font()
    apply_studio_theme()
    istate.view = state.IDE_VIEW_START
    istate.layout_mode = state.IDE_LAYOUT_SPLIT
    istate.bottom_panel = state.IDE_BOTTOM_NONE
    init_panes(&istate)
    istate.preview_zoom = 1.0
    istate.preview_scale_mode = state.IDE_PREVIEW_SCALE_FIT
    snprintf(istate.status, sizeof(istate.status), "%s", "Ready")
    InitFileDialog(&project_dialog)
}

shutdown :: () {
    CloseFileDialog(&project_dialog)
}

frame :: () {
    w := GetScreenWidth()
    h := GetScreenHeight()
    apply_studio_theme()
    BeginDrawing()
    ClearBackground(GetThemeBackground())
    BeginUIFrame(w, h, GetUIScale())
    BeginUIInspectFrame(istate.project.loaded ? istate.project.path : ".")
    draw_chrome(w, h)
    content := (Rectangle){0, (float)top_bar_height(),
                           (float)w, (float)(h - top_bar_height() - status_bar_height())}
    if istate.view == state.IDE_VIEW_START {
        start.draw_start_page(content, &istate)
    } else {
        draw_project_view(content, &istate)
    }
    if istate.project.loaded {
        was_running := istate.build_running
        prev.preview_build_poll(&istate)
        if was_running && !istate.build_running {
            # build just finished: parse diagnostics from the output buffer
            prob.problems_parse(&istate, istate.output)
            if istate.diagnostic_count > 0 {
                istate.bottom_visible = 1
                istate.bottom_tab = state.IDE_BOTTOM_PROBLEMS
                pane_move_view(&istate, state.IDE_PANE_VIEW_PROBLEMS,
                               state.IDE_PANE_BOTTOM)
            }
        }
        prev.preview_maybe_reload(&istate)
        con.console_poll(&istate)
        if ed.mod_key_down() &&
           (UIKeyDown(KEY_LEFT_SHIFT) || UIKeyDown(KEY_RIGHT_SHIFT)) &&
           UIKeyPressed(KEY_F) {
            srch.search_focus(&istate, 0)
            pane_move_view(&istate, state.IDE_PANE_VIEW_SEARCH,
                           state.IDE_PANE_BOTTOM)
        }
        if ed.mod_key_down() && UIKeyPressed(KEY_P) {
            srch.search_focus(&istate, 1)
            pane_move_view(&istate, state.IDE_PANE_VIEW_SEARCH,
                           state.IDE_PANE_BOTTOM)
        }
    }
    update_dialog(&istate)
    EndUIFocus()
    EndDrawing()
}

draw_chrome :: (view_w: int, view_h: int) {
    draw_top_bar(view_w)
    draw_status_bar(view_w, view_h)
}

draw_top_bar :: (view_w: int) {
    top_h := top_bar_height()
    DrawRectangle(0, 0, view_w, top_h, DarkenUIColor(GetThemeBackground(), 12))
    DrawLine(0, top_h - 1, view_w, top_h - 1,
             DarkenUIColor(GetThemeBackground(), 42))
    if istate.project.loaded {
        DrawUIText(istate.project.name, ScaleUIPx(12), ScaleUIPx(11),
                   ScaleUIPx(15), GetThemeText())
    } else {
        DrawUIText("Krait", ScaleUIPx(12), ScaleUIPx(11),
                   ScaleUIPx(15), GetThemeText())
    }
    if istate.project.loaded {
        draw_project_toolbar(view_w, top_h)
    }
}

draw_project_toolbar :: (view_w: int, top_h: int) {
    btn_h := ScaleUIPx(24)
    y := (top_h - btn_h) / 2
    x := view_w - ScaleUIPx(942)
    if x < ScaleUIPx(180) {
        x = ScaleUIPx(180)
    }
    if DrawUIGenericButton(x, y, ScaleUIPx(72), btn_h, "Build",
                           UI_BUTTON_STYLE_PRIMARY, 0, NULL) {
        prev.preview_build_start(&istate)
        istate.bottom_visible = 1
        istate.bottom_tab = state.IDE_BOTTOM_OUTPUT
    }
    x = x + ScaleUIPx(80)
    if DrawUIGenericButton(x, y, ScaleUIPx(70), btn_h, "Source",
                           layout_button_style(state.IDE_LAYOUT_SOURCE), 0, NULL) {
        istate.layout_mode = state.IDE_LAYOUT_SOURCE
        pane_move_view(&istate, state.IDE_PANE_VIEW_EDITOR, state.IDE_PANE_CENTER)
        pane_remove_view(&istate.pane_right, state.IDE_PANE_VIEW_PREVIEW)
    }
    x = x + ScaleUIPx(72)
    if DrawUIGenericButton(x, y, ScaleUIPx(54), btn_h, "Split",
                           layout_button_style(state.IDE_LAYOUT_SPLIT), 0, NULL) {
        istate.layout_mode = state.IDE_LAYOUT_SPLIT
        pane_move_view(&istate, state.IDE_PANE_VIEW_EDITOR, state.IDE_PANE_CENTER)
        pane_move_view(&istate, state.IDE_PANE_VIEW_PREVIEW, state.IDE_PANE_RIGHT)
    }
    x = x + ScaleUIPx(56)
    if DrawUIGenericButton(x, y, ScaleUIPx(76), btn_h, "Preview",
                           layout_button_style(state.IDE_LAYOUT_PREVIEW), 0, NULL) {
        istate.layout_mode = state.IDE_LAYOUT_PREVIEW
        pane_move_view(&istate, state.IDE_PANE_VIEW_PREVIEW, state.IDE_PANE_CENTER)
        pane_remove_view(&istate.pane_right, state.IDE_PANE_VIEW_PREVIEW)
    }
    x = x + ScaleUIPx(86)
    if DrawUIGenericButton(x, y, ScaleUIPx(76), btn_h, "Console",
                           bottom_button_style(state.IDE_BOTTOM_CONSOLE), 0, NULL) {
        show_bottom_panel(&istate, state.IDE_BOTTOM_CONSOLE)
    }
    x = x + ScaleUIPx(82)
    if DrawUIGenericButton(x, y, ScaleUIPx(72), btn_h, "Search",
                           bottom_button_style(state.IDE_BOTTOM_SEARCH), 0, NULL) {
        srch.search_focus(&istate, 0)
        pane_move_view(&istate, state.IDE_PANE_VIEW_SEARCH,
                       state.IDE_PANE_BOTTOM)
    }
    x = x + ScaleUIPx(78)
    problems_label: [32] char
    snprintf(problems_label, sizeof(problems_label), "Problems %d",
             istate.diagnostic_count)
    if DrawUIGenericButton(x, y, ScaleUIPx(104), btn_h, problems_label,
                           bottom_button_style(state.IDE_BOTTOM_PROBLEMS), 0, NULL) {
        show_bottom_panel(&istate, state.IDE_BOTTOM_PROBLEMS)
    }
    x = x + ScaleUIPx(110)
    if DrawUIGenericButton(x, y, ScaleUIPx(64), btn_h, "Output",
                           bottom_button_style(state.IDE_BOTTOM_OUTPUT), 0, NULL) {
        show_bottom_panel(&istate, state.IDE_BOTTOM_OUTPUT)
    }
    x = x + ScaleUIPx(72)
    if DrawUIGenericButton(x, y, ScaleUIPx(72), btn_h, "Explorer",
                           pane_has_view(&istate.pane_left, state.IDE_PANE_VIEW_EXPLORER) ?
                           UI_BUTTON_STYLE_TAB_SELECTED : UI_BUTTON_STYLE_TAB,
                           0, NULL) {
        pane_move_view(&istate, state.IDE_PANE_VIEW_EXPLORER, state.IDE_PANE_LEFT)
    }
}

draw_status_bar :: (view_w: int, view_h: int) {
    bar_h := status_bar_height()
    bar_y := view_h - bar_h
    DrawRectangle(0, bar_y, view_w, bar_h, DarkenUIColor(GetThemeBackground(), 20))
    DrawUIText(istate.status, ScaleUIPx(10), bar_y + ScaleUIPx(5),
               ScaleUIPx(13), GetThemeText())
}

draw_project_view :: (content: Rectangle, st: state.IdeState*) {
    init_panes(st)
    draw_workbench(content, st)
}

draw_bottom_panel :: (bounds: Rectangle, st: state.IdeState*) {
    tab_h := ScaleUIPx(30)
    pad := ScaleUIPx(8)
    DrawRectangleRec(bounds, DarkenUIColor(GetThemeBackground(), 6))
    DrawLine((int)bounds.x, (int)bounds.y,
             (int)(bounds.x + bounds.width), (int)bounds.y,
             DarkenUIColor(GetThemeBackground(), 42))
    problems_label: [32] char
    snprintf(problems_label, sizeof(problems_label), "Problems %d",
             st->diagnostic_count)
    x := (int)bounds.x + pad
    y := (int)bounds.y + ScaleUIPx(4)
    if DrawUIGenericButton(x, y, ScaleUIPx(104), ScaleUIPx(22), problems_label,
                           bottom_button_style(state.IDE_BOTTOM_PROBLEMS), 0, NULL) {
        st->bottom_tab = state.IDE_BOTTOM_PROBLEMS
    }
    x = x + ScaleUIPx(110)
    if DrawUIGenericButton(x, y, ScaleUIPx(76), ScaleUIPx(22), "Output",
                           bottom_button_style(state.IDE_BOTTOM_OUTPUT), 0, NULL) {
        st->bottom_tab = state.IDE_BOTTOM_OUTPUT
    }
    x = x + ScaleUIPx(82)
    if DrawUIGenericButton(x, y, ScaleUIPx(82), ScaleUIPx(22), "Console",
                           bottom_button_style(state.IDE_BOTTOM_CONSOLE), 0, NULL) {
        st->bottom_tab = state.IDE_BOTTOM_CONSOLE
    }
    x = x + ScaleUIPx(88)
    if DrawUIGenericButton(x, y, ScaleUIPx(76), ScaleUIPx(22), "Search",
                           bottom_button_style(state.IDE_BOTTOM_SEARCH), 0, NULL) {
        st->bottom_tab = state.IDE_BOTTOM_SEARCH
    }
    if DrawUIGenericButton((int)(bounds.x + bounds.width) - ScaleUIPx(66), y,
                           ScaleUIPx(54), ScaleUIPx(22), "Close",
                           UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        st->bottom_visible = 0
    }
    body := (Rectangle){bounds.x, bounds.y + (float)tab_h,
                        bounds.width, bounds.height - (float)tab_h}
    if st->bottom_tab == state.IDE_BOTTOM_PROBLEMS {
        prob.draw_problems(body, st)
    } else if st->bottom_tab == state.IDE_BOTTOM_CONSOLE {
        con.draw_console(body, st)
    } else if st->bottom_tab == state.IDE_BOTTOM_SEARCH {
        srch.draw_search(body, st)
    } else {
        DrawUIText(st->output, (int)body.x + ScaleUIPx(10),
                   (int)body.y + ScaleUIPx(8), ScaleUIPx(13), GetThemeText())
    }
}

show_bottom_panel :: (st: state.IdeState*, tab: int) {
    st->bottom_visible = 1
    st->bottom_tab = tab
    if tab == state.IDE_BOTTOM_PROBLEMS {
        pane_move_view(st, state.IDE_PANE_VIEW_PROBLEMS, state.IDE_PANE_BOTTOM)
    } else if tab == state.IDE_BOTTOM_CONSOLE {
        pane_move_view(st, state.IDE_PANE_VIEW_CONSOLE, state.IDE_PANE_BOTTOM)
    } else if tab == state.IDE_BOTTOM_SEARCH {
        pane_move_view(st, state.IDE_PANE_VIEW_SEARCH, state.IDE_PANE_BOTTOM)
    } else {
        pane_move_view(st, state.IDE_PANE_VIEW_OUTPUT, state.IDE_PANE_BOTTOM)
    }
}

layout_button_style :: (mode: int) -> int {
    if istate.layout_mode == mode {
        return UI_BUTTON_STYLE_TAB_SELECTED
    }
    return UI_BUTTON_STYLE_TAB
}

bottom_button_style :: (tab: int) -> int {
    if istate.bottom_visible != 0 && istate.bottom_tab == tab {
        return UI_BUTTON_STYLE_TAB_SELECTED
    }
    return UI_BUTTON_STYLE_TAB
}

init_panes :: (st: state.IdeState*) {
    if st->panes_initialized != 0 {
        return
    }
    st->panes_initialized = 1
    st->left_width = ScaleUIPx(260)
    st->right_width = ScaleUIPx(380)
    st->bottom_height = ScaleUIPx(210)
    st->resizing_pane = -1
    pane_add(&st->pane_left, state.IDE_PANE_VIEW_EXPLORER)
    pane_add(&st->pane_center, state.IDE_PANE_VIEW_EDITOR)
    pane_add(&st->pane_right, state.IDE_PANE_VIEW_PREVIEW)
}

pane_for_slot :: (st: state.IdeState*, slot: int) -> state.PaneGroup* {
    if slot == state.IDE_PANE_LEFT {
        return &st->pane_left
    }
    if slot == state.IDE_PANE_RIGHT {
        return &st->pane_right
    }
    if slot == state.IDE_PANE_BOTTOM {
        return &st->pane_bottom
    }
    return &st->pane_center
}

pane_add :: (group: state.PaneGroup*, view: int) {
    if pane_has_view(group, view) {
        return
    }
    if group->tab_count >= 8 {
        return
    }
    group->tabs[group->tab_count] = view
    group->active = group->tab_count
    group->tab_count = group->tab_count + 1
}

pane_has_view :: (group: state.PaneGroup*, view: int) -> int {
    for int i = 0; i < group->tab_count; i++ {
        if group->tabs[i] == view {
            return 1
        }
    }
    return 0
}

pane_remove_view :: (group: state.PaneGroup*, view: int) {
    for int i = 0; i < group->tab_count; i++ {
        if group->tabs[i] == view {
            for int j = i; j < group->tab_count - 1; j++ {
                group->tabs[j] = group->tabs[j + 1]
            }
            group->tab_count = group->tab_count - 1
            if group->active >= group->tab_count {
                group->active = group->tab_count - 1
            }
            if group->active < 0 && group->tab_count > 0 {
                group->active = 0
            }
            return
        }
    }
}

pane_move_view :: (st: state.IdeState*, view: int, slot: int) {
    pane_remove_view(&st->pane_left, view)
    pane_remove_view(&st->pane_center, view)
    pane_remove_view(&st->pane_right, view)
    pane_remove_view(&st->pane_bottom, view)
    pane_add(pane_for_slot(st, slot), view)
}

pane_view_label :: (view: int) -> const char* {
    if view == state.IDE_PANE_VIEW_EXPLORER {
        return "Explorer"
    }
    if view == state.IDE_PANE_VIEW_EDITOR {
        return "Editor"
    }
    if view == state.IDE_PANE_VIEW_PREVIEW {
        return "Preview"
    }
    if view == state.IDE_PANE_VIEW_PROBLEMS {
        return "Problems"
    }
    if view == state.IDE_PANE_VIEW_OUTPUT {
        return "Output"
    }
    if view == state.IDE_PANE_VIEW_CONSOLE {
        return "Console"
    }
    return "Search"
}

draw_workbench :: (content: Rectangle, st: state.IdeState*) {
    gutter := ScaleUIPx(5)
    min_w := ScaleUIPx(220)
    min_h := ScaleUIPx(140)
    left_w := st->pane_left.tab_count > 0 ? st->left_width : 0
    right_w := st->pane_right.tab_count > 0 ? st->right_width : 0
    bottom_h := st->pane_bottom.tab_count > 0 ? st->bottom_height : 0
    if content.width < (float)(min_w * 3) {
        right_w = 0
    }
    if left_w > 0 && left_w < min_w {
        left_w = min_w
    }
    if right_w > 0 && right_w < min_w {
        right_w = min_w
    }
    if bottom_h > 0 && bottom_h < min_h {
        bottom_h = min_h
    }
    top_h := content.height - (float)bottom_h
    if bottom_h > 0 {
        top_h = top_h - (float)gutter
    }
    if top_h < (float)min_h {
        top_h = (float)min_h
    }
    center_w := content.width - (float)(left_w + right_w)
    if left_w > 0 {
        center_w = center_w - (float)gutter
    }
    if right_w > 0 {
        center_w = center_w - (float)gutter
    }
    if center_w < (float)min_w {
        center_w = (float)min_w
    }

    x := content.x
    if left_w > 0 {
        left := (Rectangle){x, content.y, (float)left_w, top_h}
        draw_pane_group(left, st, &st->pane_left, state.IDE_PANE_LEFT)
        x = x + (float)left_w
        draw_resize_gutter((Rectangle){x, content.y, (float)gutter, top_h}, st,
                           state.IDE_PANE_LEFT)
        x = x + (float)gutter
    }
    center := (Rectangle){x, content.y, center_w, top_h}
    draw_pane_group(center, st, &st->pane_center, state.IDE_PANE_CENTER)
    x = x + center_w
    if right_w > 0 {
        draw_resize_gutter((Rectangle){x, content.y, (float)gutter, top_h}, st,
                           state.IDE_PANE_RIGHT)
        x = x + (float)gutter
        right := (Rectangle){x, content.y, (float)right_w, top_h}
        draw_pane_group(right, st, &st->pane_right, state.IDE_PANE_RIGHT)
    }
    if bottom_h > 0 {
        y := content.y + top_h
        draw_resize_gutter((Rectangle){content.x, y, content.width, (float)gutter}, st,
                           state.IDE_PANE_BOTTOM)
        bottom := (Rectangle){content.x, y + (float)gutter,
                              content.width, (float)bottom_h}
        draw_pane_group(bottom, st, &st->pane_bottom, state.IDE_PANE_BOTTOM)
    }
}

draw_resize_gutter :: (bounds: Rectangle, st: state.IdeState*, slot: int) {
    mouse := GetMousePosition()
    hot := CheckCollisionPointRec(mouse, bounds)
    DrawRectangleRec(bounds, hot ? GetThemeLink() : DarkenUIColor(GetThemeBackground(), 36))
    if hot && IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
        st->resizing_pane = slot
    }
    if st->resizing_pane == slot && IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
        delta := GetMouseDelta()
        if slot == state.IDE_PANE_LEFT {
            st->left_width = st->left_width + (int)delta.x
        } else if slot == state.IDE_PANE_RIGHT {
            st->right_width = st->right_width - (int)delta.x
        } else if slot == state.IDE_PANE_BOTTOM {
            st->bottom_height = st->bottom_height - (int)delta.y
        }
    }
    if st->resizing_pane == slot && IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        st->resizing_pane = -1
    }
}

draw_pane_group :: (bounds: Rectangle, st: state.IdeState*,
                    group: state.PaneGroup*, slot: int) {
    DrawRectangleRec(bounds, DarkenUIColor(GetThemeBackground(), 5))
    if slot == state.IDE_PANE_CENTER {
        DrawRectangleLinesEx(bounds, 1.0, DarkenUIColor(GetThemeBackground(), 28))
    }
    if group->tab_count <= 0 {
        return
    }
    if group->active < 0 || group->active >= group->tab_count {
        group->active = 0
    }
    header_h := ScaleUIPx(30)
    header := (Rectangle){bounds.x, bounds.y, bounds.width, (float)header_h}
    DrawRectangleRec(header, DarkenUIColor(GetThemeBackground(), 12))
    DrawLine((int)bounds.x, (int)(bounds.y + header.height),
             (int)(bounds.x + bounds.width), (int)(bounds.y + header.height),
             DarkenUIColor(GetThemeBackground(), 42))
    x := (int)bounds.x + ScaleUIPx(6)
    for int i = 0; i < group->tab_count; i++ {
        tab_w := ScaleUIPx(86)
        if group->tabs[i] == state.IDE_PANE_VIEW_PROBLEMS {
            tab_w = ScaleUIPx(104)
        }
        if DrawUIGenericButton(x, (int)bounds.y + ScaleUIPx(4), tab_w,
                               ScaleUIPx(22), pane_view_label(group->tabs[i]),
                               i == group->active ?
                               UI_BUTTON_STYLE_TAB_SELECTED : UI_BUTTON_STYLE_TAB,
                               0, NULL) {
            group->active = i
        }
        x = x + tab_w + ScaleUIPx(4)
    }
    move_x := (int)(bounds.x + bounds.width) - ScaleUIPx(136)
    active_view := group->tabs[group->active]
    if DrawUIGenericButton(move_x, (int)bounds.y + ScaleUIPx(4), ScaleUIPx(22),
                           ScaleUIPx(22), "L", UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        pane_move_view(st, active_view, state.IDE_PANE_LEFT)
        return
    }
    move_x = move_x + ScaleUIPx(24)
    if DrawUIGenericButton(move_x, (int)bounds.y + ScaleUIPx(4), ScaleUIPx(22),
                           ScaleUIPx(22), "C", UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        pane_move_view(st, active_view, state.IDE_PANE_CENTER)
        return
    }
    move_x = move_x + ScaleUIPx(24)
    if DrawUIGenericButton(move_x, (int)bounds.y + ScaleUIPx(4), ScaleUIPx(22),
                           ScaleUIPx(22), "R", UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        pane_move_view(st, active_view, state.IDE_PANE_RIGHT)
        return
    }
    move_x = move_x + ScaleUIPx(24)
    if DrawUIGenericButton(move_x, (int)bounds.y + ScaleUIPx(4), ScaleUIPx(22),
                           ScaleUIPx(22), "B", UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        pane_move_view(st, active_view, state.IDE_PANE_BOTTOM)
        return
    }
    move_x = move_x + ScaleUIPx(24)
    if DrawUIGenericButton(move_x, (int)bounds.y + ScaleUIPx(4), ScaleUIPx(22),
                           ScaleUIPx(22), "x", UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        pane_remove_view(group, active_view)
        return
    }
    body := (Rectangle){bounds.x, bounds.y + (float)header_h,
                        bounds.width, bounds.height - (float)header_h}
    draw_pane_view(body, st, group->tabs[group->active])
}

draw_pane_view :: (bounds: Rectangle, st: state.IdeState*, view: int) {
    if view == state.IDE_PANE_VIEW_EXPLORER {
        tree.draw_tree(bounds, st)
    } else if view == state.IDE_PANE_VIEW_EDITOR {
        ed.draw_editor(bounds, st)
    } else if view == state.IDE_PANE_VIEW_PREVIEW {
        prev.draw_preview(bounds, st)
    } else if view == state.IDE_PANE_VIEW_PROBLEMS {
        prob.draw_problems(bounds, st)
    } else if view == state.IDE_PANE_VIEW_CONSOLE {
        con.draw_console(bounds, st)
    } else if view == state.IDE_PANE_VIEW_SEARCH {
        srch.draw_search(bounds, st)
    } else {
        DrawUIText(st->output, (int)bounds.x + ScaleUIPx(10),
                   (int)bounds.y + ScaleUIPx(8), ScaleUIPx(13), GetThemeText())
    }
}

update_dialog :: (st: state.IdeState*) {
    if st->dialog_mode == state.IDE_DIALOG_OPEN_PROJECT {
        SetFileDialogCurrentDir(&project_dialog,
                                st->project.loaded ? st->project.path : GetWorkingDirectory())
        BeginSelectFileDialogFolder(&project_dialog, "Open Project")
        result := UpdateFileDialog(&project_dialog)
        if result == 1 {
            proj.project_open(st, GetFileDialogPath(&project_dialog))
            SetFileDialogCurrentDir(&project_dialog, st->project.path)
        } else {
            state.project_set_status(st, "Open cancelled")
        }
        project_dialog.confirmed = 0
        project_dialog.result_path[0] = 0
        st->dialog_mode = state.IDE_DIALOG_NONE
    } else if st->dialog_mode == state.IDE_DIALOG_NEW_PROJECT {
        SetFileDialogCurrentDir(&project_dialog,
                                st->project.loaded ? st->project.path : GetWorkingDirectory())
        BeginSelectFileDialogFolder(&project_dialog, "New Project Location")
        result := UpdateFileDialog(&project_dialog)
        if result == 1 {
            path := GetFileDialogPath(&project_dialog)
            if krait_scaffold_project(path, st->status, sizeof(st->status)) {
                proj.project_open(st, path)
                ed.editor_open(st, "main.kry")
                SetFileDialogCurrentDir(&project_dialog, st->project.path)
            }
        } else {
            state.project_set_status(st, "New project cancelled")
        }
        project_dialog.confirmed = 0
        project_dialog.result_path[0] = 0
        st->dialog_mode = state.IDE_DIALOG_NONE
    }
}

top_bar_height :: () -> int {
    return ScaleUIPx(40)
}

status_bar_height :: () -> int {
    return ScaleUIPx(24)
}

app "Krait" {
    size 1400 900
    fps 60
    init init
    frame frame
    shutdown shutdown
}
