#module "ide.app"
#import "kryon.h"
#import "file_dialog.h"
state :: #import "ide/state"
start :: #import "ide/start_page"
proj :: #import "ide/project"
tree :: #import "ide/tree"
screens :: #import "ide/screens"
ed :: #import "ide/editor"
prev :: #import "ide/preview"
con :: #import "ide/console"
prob :: #import "ide/problems"
srch :: #import "ide/search"
sett :: #import "ide/settings"
mods :: #import "ide/modules"
	widgets :: #import "ide/widgets"
	meta :: #import "ide/project_meta"
	krb :: #import "ide/cartridge"
	kb :: #import "ide/kanban"

	krait_load_ui_font :: () -> int #extern
krait_scaffold_project :: (path: const char*, status: char*, status_size: int) -> int #extern
krait_kanban_create :: (col: int, title: const char*) -> int #extern
krait_kanban_new_project :: (col: int, index: int, path: const char*) -> int #extern
krait_layout_load :: (st: state.IdeState*) -> int #extern
krait_layout_save :: (st: state.IdeState*) -> int #extern
krait_settings_defaults :: (st: state.IdeState*) #extern
krait_settings_load :: (st: state.IdeState*) -> int #extern
krait_settings_save :: (st: state.IdeState*) -> int #extern
krait_preview_unload :: () #extern

istate :: state.IdeState #global
project_dialog :: FileDialog #global
settings_icon :: Texture2D #global
close_icon :: Texture2D #global
project_menu_open :: int #global
pane_tabs :: [state.IDE_MAX_PANE_TABS] UITab #global
pane_tab_scroll :: [state.IDE_MAX_PANE_GROUPS] int #global

apply_krait_theme :: () {
    sett.apply_settings_theme(&istate)
}

init :: () {
    krait_load_ui_font()
    settings_icon = LoadUIIconTexture(UI_ICON_TYPE_GEAR)
    close_icon = LoadUIIconTexture(UI_ICON_TYPE_X)
    krait_settings_defaults(&istate)
    mods.register_builtins(&istate)
    krait_settings_load(&istate)
    apply_krait_theme()
    istate.view = state.IDE_VIEW_START
    istate.layout_mode = state.IDE_LAYOUT_SPLIT
    init_panes(&istate)
    krait_layout_load(&istate)
    istate.preview_zoom = 1.0
    istate.preview_scale_mode = state.IDE_PREVIEW_SCALE_FIT
    snprintf(istate.status, sizeof(istate.status), "%s", "Ready")
    InitFileDialog(&project_dialog)
}

shutdown :: () {
    krait_preview_unload()
    con.console_stop(&istate)
    krait_settings_save(&istate)
    krait_layout_save(&istate)
    if IsTextureValid(settings_icon) {
        UnloadTexture(settings_icon)
    }
    if IsTextureValid(close_icon) {
        UnloadTexture(close_icon)
    }
    CloseFileDialog(&project_dialog)
}

frame :: () {
    w := GetScreenWidth()
    h := GetScreenHeight()
    apply_krait_theme()
    BeginDrawing()
    ClearBackground(GetThemeBackground())
    BeginUIFrame(w, h, GetUIScale())
    draw_chrome(w, h)
    content := (Rectangle){0, (float)top_bar_height(),
                           (float)w, (float)(h - top_bar_height() - status_bar_height())}
    if istate.view == state.IDE_VIEW_START {
        start.draw_start_page(content, &istate)
    } else if istate.view == state.IDE_VIEW_SETTINGS {
        sett.draw_settings(content, &istate)
    } else {
        sync_preview_pane(&istate)
        draw_project_view(content, &istate)
    }
    if istate.project.loaded {
        prev.preview_maybe_reload(&istate)
        sync_preview_pane(&istate)
        con.console_poll(&istate)
        handle_pane_shortcuts(&istate)
        if ed.mod_key_down() &&
           (IsKeyDown(KEY_LEFT_SHIFT) || IsKeyDown(KEY_RIGHT_SHIFT)) &&
           IsKeyPressed(KEY_F) {
            srch.search_focus(&istate, 0)
            show_tool_bottom(&istate, state.IDE_PANE_VIEW_SEARCH)
        }
        if ed.mod_key_down() && IsKeyPressed(KEY_P) {
            srch.search_focus(&istate, 1)
            show_tool_bottom(&istate, state.IDE_PANE_VIEW_SEARCH)
        }
    }
    update_dialog(&istate)
    if istate.layout_dirty != 0 {
        krait_layout_save(&istate)
        istate.layout_dirty = 0
    }
    DrawUIOverlays()
    EndUIFocus()
    EndDrawing()
}

draw_chrome :: (view_w: int, view_h: int) {
    draw_top_bar(view_w)
    draw_status_bar(view_w, view_h)
}

draw_top_bar :: (view_w: int) {
    top_h := top_bar_height()
    DrawRectangle(0, 0, view_w, top_h, GetThemeSurface())
    DrawLine(0, top_h - 1, view_w, top_h - 1,
             GetThemeButton())
    x := ScaleUIPx(12)
    if istate.project.loaded {
        if IsUIDesktopMode() != 0 {
            if DrawUIGenericButton(x, ScaleUIPx(6), ScaleUIPx(80), ScaleUIPx(26),
                                   "Project", UI_BUTTON_STYLE_TAB,
                                   0, NULL) {
                project_menu_open = project_menu_open == 0 ? 1 : 0
            }
            DrawUIText(istate.project.name, x + ScaleUIPx(92), ScaleUIPx(11),
                       ScaleUIPx(15), GetThemeText())
        } else {
            DrawUIText(istate.project.name, x, ScaleUIPx(11),
                       ScaleUIPx(15), GetThemeText())
        }
    } else {
        DrawUIText("Krait", x, ScaleUIPx(11),
                   ScaleUIPx(15), GetThemeText())
    }
    draw_top_actions(view_w, top_h)
    if istate.project.loaded && project_menu_open != 0 {
        draw_project_menu()
    }
}

draw_project_menu :: () {
    x := ScaleUIPx(12)
    y := top_bar_height() - ScaleUIPx(2)
    w := ScaleUIPx(190)
    row_h := ScaleUIPx(30)
    DrawRectangle(x, y, w, row_h * 2 + ScaleUIPx(8), GetThemeSurface())
    DrawRectangleLines(x, y, w, row_h * 2 + ScaleUIPx(8), GetThemeButton())
    if DrawUIGenericButton(x + ScaleUIPx(4), y + ScaleUIPx(4),
                           w - ScaleUIPx(8), row_h, "Metadata",
                           UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        show_tool_right(&istate, state.IDE_PANE_VIEW_PROJECT_META)
        project_menu_open = 0
    }
    if DrawUIGenericButton(x + ScaleUIPx(4), y + ScaleUIPx(4) + row_h,
                           w - ScaleUIPx(8), row_h, "project.kryon",
                           UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        ed.editor_open(&istate, "project.kryon")
        project_menu_open = 0
    }
}

draw_top_actions :: (view_w: int, top_h: int) {
    btn_h := ScaleUIPx(24)
    y := (top_h - btn_h) / 2
    x := view_w - ScaleUIPx(36)
    icon := settings_icon
    icon_type := UI_ICON_TYPE_GEAR
    if istate.view == state.IDE_VIEW_SETTINGS {
        icon = close_icon
        icon_type = UI_ICON_TYPE_X
    }
    bg := istate.view == state.IDE_VIEW_SETTINGS ?
          GetThemeButtonHover() : GetThemeButton()
    if DrawUIIconButton((IconButtonProps){
        (Rectangle){(float)x, (float)y, (float)ScaleUIPx(24), (float)btn_h},
        icon,
        icon_type,
        ScaleUIPx(16),
        ScaleUIPx(4),
        0,
        0,
        bg,
        GetThemeButtonHover(),
        GetThemeIcon(),
        GetThemeButton(),
        0.0
    }) {
        if istate.view == state.IDE_VIEW_SETTINGS {
            istate.view = istate.project.loaded ?
                          state.IDE_VIEW_PROJECT : state.IDE_VIEW_START
        } else {
            istate.view = state.IDE_VIEW_SETTINGS
        }
    }
    if istate.project.loaded {
        gap := ScaleUIPx(6)
        redo_w := ScaleUIPx(46)
        undo_w := ScaleUIPx(52)
        x = x - gap - redo_w
        if DrawUIGenericButton(x, y, redo_w, btn_h, "Redo",
                               UI_BUTTON_STYLE_SECONDARY,
                               ed.editor_can_redo(&istate) == 0 ? 1 : 0,
                               NULL) {
            ed.editor_redo(&istate)
        }
        x = x - gap - undo_w
        if DrawUIGenericButton(x, y, undo_w, btn_h, "Undo",
                               UI_BUTTON_STYLE_SECONDARY,
                               ed.editor_can_undo(&istate) == 0 ? 1 : 0,
                               NULL) {
            ed.editor_undo(&istate)
        }
    }
}

draw_status_bar :: (view_w: int, view_h: int) {
    bar_h := status_bar_height()
    bar_y := view_h - bar_h
    DrawRectangle(0, bar_y, view_w, bar_h, GetThemeSurface())
    DrawUIText(istate.status, ScaleUIPx(10), bar_y + ScaleUIPx(5),
               ScaleUIPx(13), GetThemeText())
}

draw_project_view :: (content: Rectangle, st: state.IdeState*) {
    init_panes(st)
    draw_workbench(content, st)
}

layout_button_style :: (mode: int) -> int {
    if istate.layout_mode == mode {
        return UI_BUTTON_STYLE_TAB_SELECTED
    }
    return UI_BUTTON_STYLE_TAB
}

tool_button_style :: (view: int) -> int {
    if pane_view_exists(&istate, view) {
        return UI_BUTTON_STYLE_TAB_SELECTED
    }
    return UI_BUTTON_STYLE_TAB
}

init_panes :: (st: state.IdeState*) {
    if st->panes_initialized != 0 {
        return
    }
    st->panes_initialized = 1
    st->left_width = ScaleUIPx(380)
    st->right_width = ScaleUIPx(380)
    st->bottom_height = ScaleUIPx(210)
    st->resizing_pane = -1
    st->active_group = state.IDE_PANE_CENTER
    st->mobile_active_view = state.IDE_PANE_VIEW_PREVIEW
    st->mobile_sheet = 0
    st->drag_view = -1
    st->drag_source_group = -1
    st->drag_drop_group = -1
    st->drag_drop_zone = state.IDE_PANE_DROP_NONE
    st->navigator_tab = state.IDE_NAV_FILES
    st->active_screen = -1
    pane_layout_default(st)
}

pane_for_slot :: (st: state.IdeState*, slot: int) -> state.PaneGroup* {
    if slot < state.IDE_PANE_LEFT || slot > state.IDE_PANE_BOTTOM {
        return NULL
    }
    return &st->pane_groups[slot]
}

pane_clear_group :: (group: state.PaneGroup*) {
    group->used = 0
    group->tab_count = 0
    group->active = 0
    for int i = 0; i < state.IDE_MAX_PANE_TABS; i++ {
        group->tabs[i] = 0
    }
}

pane_clear_node :: (node: state.PaneNode*) {
    node->kind = state.IDE_PANE_NODE_EMPTY
    node->split_axis = state.IDE_PANE_SPLIT_HORIZONTAL
    node->first = -1
    node->second = -1
    node->group = -1
    node->ratio = 0.5
}

pane_reset :: (st: state.IdeState*) {
    for int i = 0; i < state.IDE_MAX_PANE_GROUPS; i++ {
        pane_clear_group(&st->pane_groups[i])
    }
    for int i = 0; i < state.IDE_MAX_PANE_NODES; i++ {
        pane_clear_node(&st->pane_nodes[i])
    }
    st->root_node = -1
    st->active_group = -1
    st->resizing_node = -1
    st->drag_active = 0
    st->drag_view = -1
    st->drag_source_group = -1
    st->drag_drop_group = -1
    st->drag_drop_zone = state.IDE_PANE_DROP_NONE
}

pane_alloc_group :: (st: state.IdeState*) -> int {
    for int i = 0; i < state.IDE_MAX_PANE_GROUPS; i++ {
        if st->pane_groups[i].used == 0 {
            pane_clear_group(&st->pane_groups[i])
            st->pane_groups[i].used = 1
            return i
        }
    }
    return -1
}

pane_alloc_leaf :: (st: state.IdeState*, group: int) -> int {
    for int i = 0; i < state.IDE_MAX_PANE_NODES; i++ {
        if st->pane_nodes[i].kind == state.IDE_PANE_NODE_EMPTY {
            st->pane_nodes[i].kind = state.IDE_PANE_NODE_LEAF
            st->pane_nodes[i].group = group
            st->pane_nodes[i].first = -1
            st->pane_nodes[i].second = -1
            st->pane_nodes[i].ratio = 0.5
            return i
        }
    }
    return -1
}

pane_alloc_split :: (st: state.IdeState*, axis: int,
                    first: int, second: int, ratio: float) -> int {
    for int i = 0; i < state.IDE_MAX_PANE_NODES; i++ {
        if st->pane_nodes[i].kind == state.IDE_PANE_NODE_EMPTY {
            st->pane_nodes[i].kind = state.IDE_PANE_NODE_SPLIT
            st->pane_nodes[i].split_axis = axis
            st->pane_nodes[i].first = first
            st->pane_nodes[i].second = second
            st->pane_nodes[i].group = -1
            st->pane_nodes[i].ratio = ratio
            return i
        }
    }
    return -1
}

pane_group :: (st: state.IdeState*, group: int) -> state.PaneGroup* {
    if group < 0 || group >= state.IDE_MAX_PANE_GROUPS {
        return NULL
    }
    if st->pane_groups[group].used == 0 {
        return NULL
    }
    return &st->pane_groups[group]
}

pane_add :: (group: state.PaneGroup*, view: int) {
    if group == NULL {
        return
    }
    if pane_has_view(group, view) {
        return
    }
    if group->tab_count >= state.IDE_MAX_PANE_TABS {
        return
    }
    group->tabs[group->tab_count] = view
    group->active = group->tab_count
    group->tab_count = group->tab_count + 1
}

pane_has_view :: (group: state.PaneGroup*, view: int) -> int {
    if group == NULL || group->used == 0 {
        return 0
    }
    for int i = 0; i < group->tab_count; i++ {
        if group->tabs[i] == view {
            return 1
        }
    }
    return 0
}

pane_remove_view :: (group: state.PaneGroup*, view: int) -> int {
    if group == NULL || group->used == 0 {
        return 0
    }
    for int i = 0; i < group->tab_count; i++ {
        if group->tabs[i] == view {
            for int j = i; j < group->tab_count - 1; j++ {
                group->tabs[j] = group->tabs[j + 1]
            }
            group->tab_count = group->tab_count - 1
            if group->active >= group->tab_count {
                group->active = group->tab_count - 1
            }
            if group->active < 0 && group->tab_count > 0 {
                group->active = 0
            }
            return 1
        }
    }
    return 0
}

pane_group_for_view :: (st: state.IdeState*, view: int) -> int {
    for int i = 0; i < state.IDE_MAX_PANE_GROUPS; i++ {
        if pane_has_view(&st->pane_groups[i], view) {
            return i
        }
    }
    return -1
}

pane_view_exists :: (st: state.IdeState*, view: int) -> int {
    return pane_group_for_view(st, view) >= 0
}

pane_focus_view :: (st: state.IdeState*, view: int) -> int {
    group_id := pane_group_for_view(st, view)
    group := pane_group(st, group_id)
    if group == NULL {
        return 0
    }
    for int i = 0; i < group->tab_count; i++ {
        if group->tabs[i] == view {
            group->active = i
            st->active_group = group_id
            return 1
        }
    }
    return 0
}

pane_node_for_group_rec :: (st: state.IdeState*, node_id: int, group: int) -> int {
    if node_id < 0 || node_id >= state.IDE_MAX_PANE_NODES {
        return -1
    }
    node := &st->pane_nodes[node_id]
    if node->kind == state.IDE_PANE_NODE_LEAF {
        return node->group == group ? node_id : -1
    }
    if node->kind == state.IDE_PANE_NODE_SPLIT {
        found := pane_node_for_group_rec(st, node->first, group)
        if found >= 0 {
            return found
        }
        return pane_node_for_group_rec(st, node->second, group)
    }
    return -1
}

pane_node_for_group :: (st: state.IdeState*, group: int) -> int {
    return pane_node_for_group_rec(st, st->root_node, group)
}

pane_find_editor_group :: (st: state.IdeState*) -> int {
    group := pane_group_for_view(st, state.IDE_PANE_VIEW_EDITOR)
    if group >= 0 {
        return group
    }
    return state.IDE_PANE_CENTER
}

pane_ensure_editor :: (st: state.IdeState*) {
    if pane_view_exists(st, state.IDE_PANE_VIEW_EDITOR) {
        return
    }
    center := pane_for_slot(st, state.IDE_PANE_CENTER)
    if center != NULL {
        center->used = 1
        pane_add(center, state.IDE_PANE_VIEW_EDITOR)
    }
}

pane_group_visible_rec :: (st: state.IdeState*, node_id: int, group: int) -> int {
    if node_id < 0 || node_id >= state.IDE_MAX_PANE_NODES {
        return 0
    }
    node := &st->pane_nodes[node_id]
    if node->kind == state.IDE_PANE_NODE_LEAF {
        return node->group == group
    }
    if node->kind == state.IDE_PANE_NODE_SPLIT {
        return pane_group_visible_rec(st, node->first, group) ||
               pane_group_visible_rec(st, node->second, group)
    }
    return 0
}

pane_first_leaf_group_rec :: (st: state.IdeState*, node_id: int) -> int {
    if node_id < 0 || node_id >= state.IDE_MAX_PANE_NODES {
        return -1
    }
    node := &st->pane_nodes[node_id]
    if node->kind == state.IDE_PANE_NODE_LEAF {
        group := pane_group(st, node->group)
        if group != NULL && group->tab_count > 0 {
            return node->group
        }
        return -1
    }
    if node->kind == state.IDE_PANE_NODE_SPLIT {
        group := pane_first_leaf_group_rec(st, node->first)
        if group >= 0 {
            return group
        }
        return pane_first_leaf_group_rec(st, node->second)
    }
    return -1
}

pane_prune_node :: (st: state.IdeState*, node_id: int) -> int {
    if node_id < 0 || node_id >= state.IDE_MAX_PANE_NODES {
        return -1
    }
    node := &st->pane_nodes[node_id]
    if node->kind == state.IDE_PANE_NODE_LEAF {
        group := pane_group(st, node->group)
        if group == NULL || group->tab_count <= 0 {
            pane_clear_node(node)
            return -1
        }
        return node_id
    }
    if node->kind == state.IDE_PANE_NODE_SPLIT {
        first := pane_prune_node(st, node->first)
        second := pane_prune_node(st, node->second)
        if first < 0 && second < 0 {
            pane_clear_node(node)
            return -1
        }
        if first < 0 {
            pane_clear_node(node)
            return second
        }
        if second < 0 {
            pane_clear_node(node)
            return first
        }
        node->first = first
        node->second = second
        return node_id
    }
    return -1
}

pane_prune_empty :: (st: state.IdeState*) {
    st->root_node = pane_prune_node(st, st->root_node)
    for int i = 0; i < state.IDE_MAX_PANE_GROUPS; i++ {
        if st->pane_groups[i].used != 0 &&
           !pane_group_visible_rec(st, st->root_node, i) {
            pane_clear_group(&st->pane_groups[i])
        }
    }
    if pane_group_for_view(st, state.IDE_PANE_VIEW_EDITOR) < 0 {
        group := pane_first_leaf_group_rec(st, st->root_node)
        if group < 0 {
            pane_layout_default(st)
            return
        }
        pane_add(&st->pane_groups[group], state.IDE_PANE_VIEW_EDITOR)
    }
    if pane_group(st, st->active_group) == NULL {
        st->active_group = pane_find_editor_group(st)
    }
}

pane_move_view_to_group :: (st: state.IdeState*, view: int, group_id: int) {
    group := pane_for_slot(st, group_id)
    if group == NULL {
        return
    }
    group->used = 1
    for int i = 0; i < state.IDE_MAX_PANE_GROUPS; i++ {
        pane_remove_view(&st->pane_groups[i], view)
    }
    pane_add(group, view)
    st->active_group = group_id
    pane_ensure_editor(st)
    st->layout_dirty = 1
}

pane_split_group_with_view :: (st: state.IdeState*, group_id: int,
                               view: int, drop_zone: int) {
    if drop_zone == state.IDE_PANE_DROP_CENTER {
        pane_move_view_to_group(st, view, group_id)
        return
    }
    target := pane_group(st, group_id)
    if target == NULL {
        group_id = pane_find_editor_group(st)
        target = pane_group(st, group_id)
    }
    target_node := pane_node_for_group(st, group_id)
    if target == NULL || target_node < 0 {
        return
    }
    old_group_id := pane_group_for_view(st, view)
    old_group := pane_group(st, old_group_id)
    if old_group_id == group_id && old_group != NULL && old_group->tab_count <= 1 {
        return
    }
    for int i = 0; i < state.IDE_MAX_PANE_GROUPS; i++ {
        pane_remove_view(&st->pane_groups[i], view)
    }
    new_group := pane_alloc_group(st)
    if new_group < 0 {
        pane_add(target, view)
        return
    }
    pane_add(&st->pane_groups[new_group], view)
    old_leaf := pane_alloc_leaf(st, group_id)
    new_leaf := pane_alloc_leaf(st, new_group)
    if old_leaf < 0 || new_leaf < 0 {
        pane_add(target, view)
        pane_prune_empty(st)
        return
    }
    node := &st->pane_nodes[target_node]
    node->kind = state.IDE_PANE_NODE_SPLIT
    node->group = -1
    if drop_zone == state.IDE_PANE_DROP_LEFT ||
       drop_zone == state.IDE_PANE_DROP_RIGHT {
        node->split_axis = state.IDE_PANE_SPLIT_HORIZONTAL
    } else {
        node->split_axis = state.IDE_PANE_SPLIT_VERTICAL
    }
    if drop_zone == state.IDE_PANE_DROP_LEFT ||
       drop_zone == state.IDE_PANE_DROP_TOP {
        node->first = new_leaf
        node->second = old_leaf
        node->ratio = 0.30
    } else {
        node->first = old_leaf
        node->second = new_leaf
        node->ratio = 0.70
    }
    st->active_group = new_group
    pane_prune_empty(st)
    st->layout_dirty = 1
}

show_tool_center :: (st: state.IdeState*, view: int) {
    if pane_focus_view(st, view) {
        return
    }
    pane_move_view_to_group(st, view, state.IDE_PANE_CENTER)
}

show_tool_bottom :: (st: state.IdeState*, view: int) {
    if pane_focus_view(st, view) {
        return
    }
    if st->bottom_height <= 0 {
        st->bottom_height = ScaleUIPx(210)
    }
    pane_move_view_to_group(st, view, state.IDE_PANE_BOTTOM)
}

show_tool_right :: (st: state.IdeState*, view: int) {
    if pane_focus_view(st, view) {
        return
    }
    pane_move_view_to_group(st, view, state.IDE_PANE_RIGHT)
}

show_tool_left :: (st: state.IdeState*, view: int) {
    if pane_focus_view(st, view) {
        return
    }
    pane_move_view_to_group(st, view, state.IDE_PANE_LEFT)
}

pane_layout_default :: (st: state.IdeState*) {
    pane_reset(st)
    st->pane_groups[state.IDE_PANE_LEFT].used = 1
    st->pane_groups[state.IDE_PANE_CENTER].used = 1
    st->pane_groups[state.IDE_PANE_RIGHT].used = 1
    st->pane_groups[state.IDE_PANE_BOTTOM].used = 1
    pane_add(&st->pane_groups[state.IDE_PANE_LEFT], state.IDE_PANE_VIEW_FILES)
    pane_add(&st->pane_groups[state.IDE_PANE_LEFT], state.IDE_PANE_VIEW_EXPLORER)
    pane_add(&st->pane_groups[state.IDE_PANE_LEFT], state.IDE_PANE_VIEW_HIERARCHY)
    pane_add(&st->pane_groups[state.IDE_PANE_LEFT], state.IDE_PANE_VIEW_WIDGETS)
    st->pane_groups[state.IDE_PANE_LEFT].active = 2
    pane_add(&st->pane_groups[state.IDE_PANE_CENTER], state.IDE_PANE_VIEW_EDITOR)
    pane_add(&st->pane_groups[state.IDE_PANE_CENTER], state.IDE_PANE_VIEW_PREVIEW)
    pane_add(&st->pane_groups[state.IDE_PANE_CENTER], state.IDE_PANE_VIEW_KANBAN)
    st->pane_groups[state.IDE_PANE_CENTER].active = 1
    pane_add(&st->pane_groups[state.IDE_PANE_RIGHT], state.IDE_PANE_VIEW_INSPECTOR)
    pane_add(&st->pane_groups[state.IDE_PANE_BOTTOM], state.IDE_PANE_VIEW_CONSOLE)
    pane_add(&st->pane_groups[state.IDE_PANE_BOTTOM], state.IDE_PANE_VIEW_PROBLEMS)
    st->bottom_height = ScaleUIPx(220)
    st->active_group = state.IDE_PANE_CENTER
}

pane_layout_source :: (st: state.IdeState*) {
    st->layout_mode = state.IDE_LAYOUT_SOURCE
    pane_layout_default(st)
    st->layout_dirty = 1
}

pane_layout_split :: (st: state.IdeState*) {
    st->layout_mode = state.IDE_LAYOUT_SPLIT
    if mods.has_preview_provider(st) == 0 {
        pane_layout_default(st)
        st->layout_dirty = 1
        return
    }
    pane_layout_default(st)
    pane_focus_view(st, state.IDE_PANE_VIEW_PREVIEW)
    st->layout_dirty = 1
}

pane_layout_preview :: (st: state.IdeState*) {
    if mods.has_preview_provider(st) == 0 {
        pane_layout_source(st)
        return
    }
    st->layout_mode = state.IDE_LAYOUT_PREVIEW
    pane_layout_default(st)
    pane_focus_view(st, state.IDE_PANE_VIEW_PREVIEW)
    st->layout_dirty = 1
}

pane_view_label :: (view: int) -> const char* {
    if view == state.IDE_PANE_VIEW_EXPLORER {
        return "Scenes"
    }
    if view == state.IDE_PANE_VIEW_FILES {
        return "Files"
    }
    if view == state.IDE_PANE_VIEW_EDITOR {
        return "Source"
    }
    if view == state.IDE_PANE_VIEW_PREVIEW {
        return "Canvas"
    }
    if view == state.IDE_PANE_VIEW_WIDGETS {
        return "Nodes"
    }
    if view == state.IDE_PANE_VIEW_HIERARCHY {
        return "Hierarchy"
    }
    if view == state.IDE_PANE_VIEW_INSPECTOR {
        return "Inspector"
    }
    if view == state.IDE_PANE_VIEW_PROJECT_META {
        return "Metadata"
    }
    if view == state.IDE_PANE_VIEW_PROBLEMS {
        return "Problems"
    }
    if view == state.IDE_PANE_VIEW_CONSOLE {
        return "Terminal"
    }
    if view == state.IDE_PANE_VIEW_CARTRIDGE {
        return "Cartridge"
    }
    if view == state.IDE_PANE_VIEW_KANBAN {
        return "Kanban"
    }
    return "Search"
}

sync_preview_pane :: (st: state.IdeState*) {
    has_preview := pane_view_exists(st, state.IDE_PANE_VIEW_PREVIEW)
    if mods.has_preview_provider(st) == 0 {
        if has_preview {
            for int i = 0; i < state.IDE_MAX_PANE_GROUPS; i++ {
                pane_remove_view(&st->pane_groups[i], state.IDE_PANE_VIEW_PREVIEW)
            }
            pane_ensure_editor(st)
            st->layout_dirty = 1
        }
        st->preview_host_ready = 0
        return
    }
}

mobile_nav_button :: (x: int, y: int, w: int, h: int, label: const char*,
                      view: int, st: state.IdeState*) {
    active := st->mobile_active_view == view
    style := active ? UI_BUTTON_STYLE_PRIMARY : UI_BUTTON_STYLE_TAB
    if DrawUIGenericButton(x, y, w, h, label, style, 0, NULL) {
        st->mobile_active_view = view
        st->layout_dirty = 1
    }
}

# Mobile (phone) layout: one full-width pane for the active view, with a
# touch-sized bottom navigation bar. Takes over from the 3-column workbench
# whenever IsUIDesktopMode() is false (narrow viewport).
draw_workbench_mobile :: (content: Rectangle, st: state.IdeState*) {
    nav_h := ScaleUIPx(56)
    pane := (Rectangle){content.x, content.y,
                        content.width, content.height - (float)nav_h}
    draw_pane_view(pane, st, st->mobile_active_view)
    nav_y := (int)(content.y + content.height) - nav_h
    cw := (int)content.width
    DrawRectangle((int)content.x, nav_y, cw, nav_h, GetThemeSurface())
    DrawLine((int)content.x, nav_y, (int)content.x + cw, nav_y, GetThemeButton())
    count := 5
    btn_w := cw / count
    btn_h := nav_h - ScaleUIPx(16)
    by := nav_y + ScaleUIPx(8)
    bx := (int)content.x
    mobile_nav_button(bx, by, btn_w, btn_h, "Canvas", state.IDE_PANE_VIEW_PREVIEW, st)
    bx = bx + btn_w
    mobile_nav_button(bx, by, btn_w, btn_h, "Nodes", state.IDE_PANE_VIEW_HIERARCHY, st)
    bx = bx + btn_w
    mobile_nav_button(bx, by, btn_w, btn_h, "Inspect", state.IDE_PANE_VIEW_INSPECTOR, st)
    bx = bx + btn_w
    mobile_nav_button(bx, by, btn_w, btn_h, "Files", state.IDE_PANE_VIEW_FILES, st)
    bx = bx + btn_w
    mobile_nav_button(bx, by, btn_w, btn_h, "Source", state.IDE_PANE_VIEW_EDITOR, st)
}

draw_workbench :: (content: Rectangle, st: state.IdeState*) {
    if IsUIDesktopMode() == 0 || st->force_mobile_layout != 0 {
        draw_workbench_mobile(content, st)
        return
    }
    gutter := ScaleUIPx(5)
    min_w := ScaleUIPx(220)
    min_h := ScaleUIPx(140)
    left := pane_for_slot(st, state.IDE_PANE_LEFT)
    right := pane_for_slot(st, state.IDE_PANE_RIGHT)
    bottom_group := pane_for_slot(st, state.IDE_PANE_BOTTOM)
    if st->drag_active != 0 {
        st->drag_drop_group = -1
        st->drag_drop_zone = state.IDE_PANE_DROP_NONE
    }
    left_w := st->left_width
    right_w := st->right_width
    bottom_h := st->bottom_height
    if bottom_group == NULL || bottom_group->tab_count <= 0 {
        bottom_h = 0
    }
    if left_w > 0 && left_w < min_w {
        left_w = min_w
    }
    if right_w > 0 && right_w < min_w {
        right_w = min_w
    }
    if bottom_h > 0 && bottom_h < min_h {
        bottom_h = min_h
    }
    top_h := content.height - (float)bottom_h
    if bottom_h > 0 {
        top_h = top_h - (float)gutter
    }
    if top_h < (float)min_h {
        top_h = (float)min_h
    }
    center_w := content.width - (float)(left_w + right_w)
    center_w = center_w - (float)(gutter * 2)
    if center_w < (float)min_w {
        center_w = (float)min_w
    }

    x := content.x
    left_bounds := (Rectangle){x, content.y, (float)left_w, top_h}
    draw_pane_group(left_bounds, st, left, state.IDE_PANE_LEFT)
    x = x + (float)left_w
    draw_resize_gutter((Rectangle){x, content.y, (float)gutter, top_h}, st,
                       state.IDE_PANE_LEFT)
    x = x + (float)gutter
    center := (Rectangle){x, content.y, center_w, top_h}
    draw_pane_group(center, st, pane_for_slot(st, state.IDE_PANE_CENTER),
                    state.IDE_PANE_CENTER)
    x = x + center_w
    draw_resize_gutter((Rectangle){x, content.y, (float)gutter, top_h}, st,
                       state.IDE_PANE_RIGHT)
    x = x + (float)gutter
    right_bounds := (Rectangle){x, content.y, (float)right_w, top_h}
    draw_pane_group(right_bounds, st, right, state.IDE_PANE_RIGHT)

    if bottom_h > 0 {
        y := content.y + top_h
        draw_resize_gutter((Rectangle){content.x, y, content.width, (float)gutter}, st,
                           state.IDE_PANE_BOTTOM)
        bottom := (Rectangle){content.x, y + (float)gutter,
                              content.width, (float)bottom_h}
        draw_pane_group(bottom, st, bottom_group, state.IDE_PANE_BOTTOM)
    }
    finish_pane_drag(st)
    if st->widget_drag_active != 0 && !IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
        st->widget_drag_active = 0
        st->widget_drag_type = -1
    }
    widgets.draw_drag_overlay(st)
}

draw_pane_node :: (bounds: Rectangle, st: state.IdeState*, node_id: int) {
    if node_id < 0 || node_id >= state.IDE_MAX_PANE_NODES {
        return
    }
    node := &st->pane_nodes[node_id]
    if node->kind == state.IDE_PANE_NODE_LEAF {
        group := pane_group(st, node->group)
        if group != NULL {
            draw_pane_group(bounds, st, group, node->group)
        }
        return
    }
    if node->kind != state.IDE_PANE_NODE_SPLIT {
        return
    }
    gutter := ScaleUIPx(5)
    if node->ratio < 0.15 {
        node->ratio = 0.15
    }
    if node->ratio > 0.85 {
        node->ratio = 0.85
    }
    if node->split_axis == state.IDE_PANE_SPLIT_HORIZONTAL {
        split := (bounds.width - (float)gutter) * node->ratio
        first := (Rectangle){bounds.x, bounds.y, split, bounds.height}
        gap := (Rectangle){bounds.x + split, bounds.y, (float)gutter, bounds.height}
        second := (Rectangle){gap.x + gap.width, bounds.y,
                              bounds.width - split - (float)gutter, bounds.height}
        draw_pane_node(first, st, node->first)
        draw_resize_gutter(gap, st, node_id)
        draw_pane_node(second, st, node->second)
    } else {
        split := (bounds.height - (float)gutter) * node->ratio
        first := (Rectangle){bounds.x, bounds.y, bounds.width, split}
        gap := (Rectangle){bounds.x, bounds.y + split, bounds.width, (float)gutter}
        second := (Rectangle){bounds.x, gap.y + gap.height,
                              bounds.width, bounds.height - split - (float)gutter}
        draw_pane_node(first, st, node->first)
        draw_resize_gutter(gap, st, node_id)
        draw_pane_node(second, st, node->second)
    }
}

draw_resize_gutter :: (bounds: Rectangle, st: state.IdeState*, slot: int) {
    mouse := GetMousePosition()
    hot := CheckCollisionPointRec(mouse, bounds) || st->resizing_pane == slot
    if hot {
        if slot == state.IDE_PANE_BOTTOM {
            MarkUICursor(MOUSE_CURSOR_RESIZE_NS)
        } else {
            MarkUICursor(MOUSE_CURSOR_RESIZE_EW)
        }
    }
    DrawRectangleRec(bounds, hot ? GetThemeLink() : GetThemeButton())
    if hot && IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
        st->resizing_pane = slot
    }
    if st->resizing_pane == slot && IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
        delta := GetMouseDelta()
        if slot == state.IDE_PANE_LEFT {
            st->left_width = st->left_width + (int)delta.x
        } else if slot == state.IDE_PANE_RIGHT {
            st->right_width = st->right_width - (int)delta.x
        } else if slot == state.IDE_PANE_BOTTOM {
            st->bottom_height = st->bottom_height - (int)delta.y
        }
    }
    if st->resizing_pane == slot && !IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
        st->resizing_pane = -1
        st->layout_dirty = 1
    }
}

draw_pane_group :: (bounds: Rectangle, st: state.IdeState*,
                    group: state.PaneGroup*, group_id: int) {
    if group == NULL {
        return
    }
    apply_krait_theme()
    mouse := GetMousePosition()
    drop_hot := st->drag_active != 0 && CheckCollisionPointRec(mouse, bounds)
    if st->drag_active != 0 {
        MarkUICursor(MOUSE_CURSOR_RESIZE_ALL)
    }
    DrawRectangleRec(bounds, GetThemeSurface())
    if CheckCollisionPointRec(mouse, bounds) &&
       IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
        st->active_group = group_id
    }
    DrawRectangleLinesEx(bounds, 1.0, GetThemeButton())
    if drop_hot {
        st->drag_drop_group = group_id
        st->drag_drop_zone = GetUIPaneDropZone(bounds, mouse)
        DrawUIPaneDropPreview(bounds, st->drag_drop_zone)
    }
    if group->tab_count <= 0 {
        return
    }
    if group->active < 0 || group->active >= group->tab_count {
        group->active = 0
    }
    header_h := GetUITabBarHeight()
    header := (Rectangle){bounds.x, bounds.y, bounds.width, (float)header_h}
    min_tab_w := ScaleUIPx(88)
    max_tab_w := ScaleUIPx(140)
    if group_id == state.IDE_PANE_LEFT {
        min_tab_w = ScaleUIPx(62)
        max_tab_w = ScaleUIPx(104)
    }
    for int i = 0; i < group->tab_count; i++ {
        tab_view := group->tabs[i]
        pane_tabs[i].label = pane_view_label(tab_view)
        pane_tabs[i].icon = (Texture2D){0}
        pane_tabs[i].icon_size = 0
        pane_tabs[i].disabled = 0
        pane_tabs[i].accent = (Color){0}
        pane_tabs[i].italic = 0
        pane_tabs[i].closeable = 0
    }
    dragged := -1
    result := DrawUIPaneTabBar((UIPaneTabBar){
        header, pane_tabs, group->tab_count, group->active,
        ScaleUIPx(12), min_tab_w, max_tab_w,
        &pane_tab_scroll[group_id], &dragged
    })
    if result.clicked_index >= 0 {
        group->active = result.clicked_index
        st->active_group = group_id
        st->layout_dirty = 1
    }
    if result.dragged_index >= 0 {
        group->active = result.dragged_index
        st->drag_active = 1
        st->drag_view = group->tabs[result.dragged_index]
        st->drag_source_group = group_id
        st->active_group = group_id
    }
    body := (Rectangle){bounds.x, bounds.y + (float)header_h,
                        bounds.width, bounds.height - (float)header_h}
    draw_pane_view(body, st, group->tabs[group->active])
}

finish_pane_drag :: (st: state.IdeState*) {
    if st->drag_active == 0 {
        return
    }
    if !IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
        if st->drag_view >= 0 && st->drag_drop_group >= state.IDE_PANE_LEFT &&
           st->drag_drop_group <= state.IDE_PANE_BOTTOM {
            target := st->drag_drop_group
            if st->drag_drop_zone == state.IDE_PANE_DROP_LEFT {
                target = state.IDE_PANE_LEFT
            } else if st->drag_drop_zone == state.IDE_PANE_DROP_RIGHT {
                target = state.IDE_PANE_RIGHT
            } else if st->drag_drop_zone == state.IDE_PANE_DROP_BOTTOM {
                target = state.IDE_PANE_BOTTOM
            } else if st->drag_drop_zone == state.IDE_PANE_DROP_TOP {
                target = state.IDE_PANE_CENTER
            }
            if target != st->drag_source_group {
                pane_move_view_to_group(st, st->drag_view, target)
            }
        }
        st->drag_active = 0
        st->drag_view = -1
        st->drag_source_group = -1
        st->drag_drop_group = -1
        st->drag_drop_zone = state.IDE_PANE_DROP_NONE
    }
}

handle_pane_shortcuts :: (st: state.IdeState*) {
    if ed.mod_key_down() && IsKeyPressed(KEY_GRAVE) {
        show_tool_bottom(st, state.IDE_PANE_VIEW_CONSOLE)
        con.console_focus(st)
        return
    }
    if !ed.mod_key_down() {
        return
    }
    if !(IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT)) {
        return
    }
    group := pane_group(st, st->active_group)
    if group == NULL || group->tab_count <= 0 {
        return
    }
    if group->active < 0 || group->active >= group->tab_count {
        group->active = 0
    }
    view := group->tabs[group->active]
    if IsKeyPressed(KEY_LEFT) {
        pane_move_view_to_group(st, view, state.IDE_PANE_LEFT)
    } else if IsKeyPressed(KEY_RIGHT) {
        pane_move_view_to_group(st, view, state.IDE_PANE_RIGHT)
    } else if IsKeyPressed(KEY_DOWN) {
        pane_move_view_to_group(st, view, state.IDE_PANE_BOTTOM)
    } else if IsKeyPressed(KEY_UP) {
        pane_move_view_to_group(st, view, state.IDE_PANE_CENTER)
    }
}

draw_pane_view :: (bounds: Rectangle, st: state.IdeState*, view: int) {
    apply_krait_theme()
    if view == state.IDE_PANE_VIEW_EXPLORER {
        screens.draw_screens(bounds, st)
    } else if view == state.IDE_PANE_VIEW_FILES {
        tree.draw_tree(bounds, st)
    } else if view == state.IDE_PANE_VIEW_EDITOR {
        ed.draw_editor(bounds, st)
    } else if view == state.IDE_PANE_VIEW_PREVIEW {
        prev.draw_preview(bounds, st)
        apply_krait_theme()
    } else if view == state.IDE_PANE_VIEW_WIDGETS {
        widgets.draw_widgets(bounds, st)
    } else if view == state.IDE_PANE_VIEW_HIERARCHY {
        widgets.draw_hierarchy(bounds, st)
    } else if view == state.IDE_PANE_VIEW_INSPECTOR {
        widgets.draw_inspector(bounds, st)
    } else if view == state.IDE_PANE_VIEW_PROJECT_META {
        meta.draw_project_metadata(bounds, st)
    } else if view == state.IDE_PANE_VIEW_PROBLEMS {
        prob.draw_problems(bounds, st)
    } else if view == state.IDE_PANE_VIEW_CONSOLE {
        con.draw_console(bounds, st)
    } else if view == state.IDE_PANE_VIEW_SEARCH {
        srch.draw_search(bounds, st)
    } else if view == state.IDE_PANE_VIEW_CARTRIDGE {
        krb.draw_cartridge(bounds, st)
    } else if view == state.IDE_PANE_VIEW_KANBAN {
        kb.draw_kanban(bounds, st)
    } else {
        DrawRectangleRec(bounds, GetThemeSurface())
        DrawUIText(st->output, (int)bounds.x + ScaleUIPx(10),
                   (int)bounds.y + ScaleUIPx(8), ScaleUIPx(13), GetThemeText())
    }
}

update_dialog :: (st: state.IdeState*) {
    if st->dialog_mode == state.IDE_DIALOG_OPEN_PROJECT {
        SetFileDialogCurrentDir(&project_dialog,
                                st->project.loaded ? st->project.path : GetWorkingDirectory())
        BeginSelectFileDialogFolder(&project_dialog, "Open Project")
        result := UpdateFileDialog(&project_dialog)
        if result == 1 {
            proj.project_open(st, GetFileDialogPath(&project_dialog))
            SetFileDialogCurrentDir(&project_dialog, st->project.path)
        } else {
            state.project_set_status(st, "Open cancelled")
        }
        project_dialog.confirmed = 0
        project_dialog.result_path[0] = 0
        st->dialog_mode = state.IDE_DIALOG_NONE
    } else if st->dialog_mode == state.IDE_DIALOG_NEW_PROJECT {
        SetFileDialogCurrentDir(&project_dialog,
                                st->project.loaded ? st->project.path : GetWorkingDirectory())
        BeginSelectFileDialogFolder(&project_dialog, "New Project Location")
        result := UpdateFileDialog(&project_dialog)
        if result == 1 {
            path := GetFileDialogPath(&project_dialog)
            if krait_scaffold_project(path, st->status, sizeof(st->status)) {
                proj.project_open(st, path)
                startup_file: [1024] char
                if mods.preferred_startup_file(st, startup_file,
                                               sizeof(startup_file)) {
                    ed.editor_open(st, startup_file)
                }
                SetFileDialogCurrentDir(&project_dialog, st->project.path)
            }
        } else {
            state.project_set_status(st, "New project cancelled")
        }
        project_dialog.confirmed = 0
        project_dialog.result_path[0] = 0
        st->dialog_mode = state.IDE_DIALOG_NONE
    } else if st->dialog_mode == state.IDE_DIALOG_KANBAN_PROJECT {
        SetFileDialogCurrentDir(&project_dialog,
                                st->project.loaded ? st->project.path : GetWorkingDirectory())
        BeginSelectFileDialogFolder(&project_dialog, "New Kanban Project")
        result := UpdateFileDialog(&project_dialog)
        if result == 1 {
            path := GetFileDialogPath(&project_dialog)
            index := krait_kanban_create(0, "Project card")
            if index >= 0 && krait_kanban_new_project(0, index, path) {
                state.project_set_status(st, "Kanban project scaffolded")
            } else {
                state.project_set_status(st, "Scaffold failed")
            }
        }
        project_dialog.confirmed = 0
        project_dialog.result_path[0] = 0
        st->dialog_mode = state.IDE_DIALOG_NONE
    }
}

top_bar_height :: () -> int {
    return ScaleUIPx(40)
}

status_bar_height :: () -> int {
    return ScaleUIPx(24)
}

app "Krait" {
    size 1400 900
    fps 60
    init init
    frame frame
    shutdown shutdown
}
