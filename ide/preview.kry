#module "ide.preview"
#import "kryon.h"
#import <string.h>
state :: #import "ide/state"

kry_dylib_load :: (path: const char*) -> void* #extern
kry_dylib_sym :: (handle: void*, name: const char*) -> void* #extern
kry_dylib_close :: (handle: void*) #extern
kry_process_spawn :: (p: KryProcess*, command: const char*, cwd: const char*) -> int #extern
kry_process_read_poll :: (p: KryProcess*, buf: char*, cap: int) -> int #extern
kry_process_wait_poll :: (p: KryProcess*) -> int #extern
kry_process_kill :: (p: KryProcess*) #extern
kry_process_close :: (p: KryProcess*) #extern
kry_fs_mtime :: (path: const char*) -> long #extern

CreateHostFn :: AppHost* (*)(int, const char*) #type
DestroyHostFn :: void (*)(AppHost*) #type

#global

#private

build_command :: (dst: char*, dst_size: int) {
    snprintf(dst, dst_size, "%s",
        "if [ -d vendor/kryon ]; then KRYON_DIR=vendor/kryon make kryon-host; else make kryon-host; fi")
}

preview_unload_host :: (st: state.IdeState*) {
    if st->host != NULL {
        lib := st->host_library
        # destroy_host is resolved at load time; we can't easily re-resolve here,
        # so call DrawAppScreen's sibling via the stored library. For simplicity,
        # leak the host on unload (rebuild creates a fresh one).
        st->host = NULL
        if lib != NULL {
            kry_dylib_close(lib)
            st->host_library = NULL
        }
    }
}

preview_load_host :: (st: state.IdeState*) -> int {
    path: [1024] char
    snprintf(path, sizeof(path), "%s/build/kryon/app_host.so", st->project.path)
    lib := kry_dylib_load(path)
    if lib == NULL {
        state.project_set_status(st, "No app host built")
        return 0
    }
    create_raw := kry_dylib_sym(lib, "CreateAppHost")
    destroy_raw := kry_dylib_sym(lib, "DestroyAppHost")
    if create_raw == NULL || destroy_raw == NULL {
        kry_dylib_close(lib)
        state.project_set_status(st, "App host missing entry symbols")
        return 0
    }
    create_host := (CreateHostFn)create_raw
    preview_unload_host(st)
    st->host_library = lib
    st->host = create_host(APP_HOST_ABI_VERSION, st->project.path)
    if st->host == NULL {
        state.project_set_status(st, "CreateAppHost failed")
        return 0
    }
    state.project_set_status(st, "Preview loaded")
    return 1
}

preview_build_start :: (st: state.IdeState*) {
    if st->build_running {
        return
    }
    cmd: [512] char
    build_command(cmd, sizeof(cmd))
    if kry_process_spawn(&st->build_proc, cmd, st->project.path) {
        st->build_running = 1
        st->output[0] = 0
        state.project_set_status(st, "Building...")
    }
}

preview_build_poll :: (st: state.IdeState*) {
    if !st->build_running {
        return
    }
    buf: [4096] char
    drained := 0
    while drained == 0 {
        n := kry_process_read_poll(&st->build_proc, buf, sizeof(buf))
        if n <= 0 {
            drained = 1
        } else {
            cur := strlen(st->output)
            room := sizeof(st->output) - cur - 1
            if room > 0 {
                strncat(st->output, buf, room)
            }
        }
    }
    if kry_process_wait_poll(&st->build_proc) {
        st->build_running = 0
        kry_process_close(&st->build_proc)
        if st->build_proc.exit_status == 0 {
            preview_load_host(st)
        } else {
            state.project_set_status(st, "Build failed")
        }
    }
}

preview_maybe_reload :: (st: state.IdeState*) {
    now := GetTime()
    if st->build_running {
        return
    }
    if now - st->last_reload_check < 1.0 {
        return
    }
    st->last_reload_check = now
    mtime := kry_fs_mtime(st->project.path)
    if mtime > st->source_mtime {
        st->source_mtime = mtime
        preview_build_start(st)
    }
}

ensure_texture :: (st: state.IdeState*, w: int, h: int) -> int {
    if st->preview_texture_w == w && st->preview_texture_h == h {
        return 1
    }
    if st->preview_texture_w != 0 {
        UnloadRenderTexture(st->preview_texture)
    }
    st->preview_texture = LoadRenderTexture(w, h)
    st->preview_texture_w = w
    st->preview_texture_h = h
    return 1
}

preview_set_fit :: (st: state.IdeState*) {
    st->preview_scale_mode = state.IDE_PREVIEW_SCALE_FIT
    st->preview_zoom = 1.0
    st->preview_pan_x = 0.0
    st->preview_pan_y = 0.0
    state.project_set_status(st, "Preview fit")
}

preview_set_zoom :: (st: state.IdeState*, zoom: float) {
    if zoom < 0.25 {
        zoom = 0.25
    }
    if zoom > 6.0 {
        zoom = 6.0
    }
    st->preview_scale_mode = state.IDE_PREVIEW_SCALE_CUSTOM
    st->preview_zoom = zoom
    state.project_set_status(st, "Preview zoom")
}

draw_preview_toolbar :: (bounds: Rectangle, st: state.IdeState*) {
    y := (int)bounds.y + ScaleUIPx(4)
    x := (int)bounds.x + ScaleUIPx(6)
    h := ScaleUIPx(22)
    if DrawUIGenericButton(x, y, ScaleUIPx(42), h, "Fit",
                           st->preview_scale_mode == state.IDE_PREVIEW_SCALE_FIT ?
                               UI_BUTTON_STYLE_TAB_SELECTED : UI_BUTTON_STYLE_TAB,
                           0, NULL) {
        preview_set_fit(st)
    }
    x = x + ScaleUIPx(48)
    if DrawUIGenericButton(x, y, ScaleUIPx(36), h, "50",
                           UI_BUTTON_STYLE_TAB, 0, NULL) {
        preview_set_zoom(st, 0.5)
    }
    x = x + ScaleUIPx(40)
    if DrawUIGenericButton(x, y, ScaleUIPx(36), h, "75",
                           UI_BUTTON_STYLE_TAB, 0, NULL) {
        preview_set_zoom(st, 0.75)
    }
    x = x + ScaleUIPx(40)
    if DrawUIGenericButton(x, y, ScaleUIPx(42), h, "100",
                           UI_BUTTON_STYLE_TAB, 0, NULL) {
        preview_set_zoom(st, 1.0)
    }
    x = x + ScaleUIPx(48)
    if DrawUIGenericButton(x, y, ScaleUIPx(28), h, "-",
                           UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        preview_set_zoom(st, st->preview_zoom * 0.85)
    }
    x = x + ScaleUIPx(32)
    if DrawUIGenericButton(x, y, ScaleUIPx(28), h, "+",
                           UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        preview_set_zoom(st, st->preview_zoom * 1.18)
    }
}

draw_preview :: (bounds: Rectangle, st: state.IdeState*) {
    toolbar_h := ScaleUIPx(30)
    draw_preview_toolbar((Rectangle){bounds.x, bounds.y, bounds.width,
                                     (float)toolbar_h}, st)
    content := (Rectangle){bounds.x, bounds.y + (float)toolbar_h,
                           bounds.width, bounds.height - (float)toolbar_h}
    if st->host == NULL {
        DrawUIText("No preview",
                   (int)content.x + ScaleUIPx(16), (int)content.y + ScaleUIPx(16),
                   ScaleUIPx(15), GetThemeText())
        return
    }
    pw := ScaleUIPx(320)
    ph := ScaleUIPx(240)
    if pw < 1 {
        pw = 1
    }
    if ph < 1 {
        ph = 1
    }
    ensure_texture(st, pw, ph)
    BeginTextureMode(st->preview_texture)
    ClearBackground(GetThemeBackground())
    BeginUIFrame(pw, ph, 1.0)
    DrawAppScreen(st->host, (Rectangle){0, 0, (float)pw, (float)ph})
    EndUIFocus()
    EndTextureMode()
    SetCurrentTheme(THEME_MONO, 0)
    BeginUIFrame(GetScreenWidth(), GetScreenHeight(), GetUIScale())
    BeginUIInspectFrame(st->project.path)
    scale_x := content.width / (float)pw
    scale_y := content.height / (float)ph
    scale := scale_x
    if scale_y < scale {
        scale = scale_y
    }
    if st->preview_scale_mode == state.IDE_PREVIEW_SCALE_CUSTOM {
        if st->preview_zoom <= 0.0 {
            st->preview_zoom = 1.0
        }
        scale = st->preview_zoom
    } else {
        st->preview_pan_x = 0.0
        st->preview_pan_y = 0.0
    }
    mouse := GetMousePosition()
    if CheckCollisionPointRec(mouse, content) {
        wheel := GetMouseWheelMove()
        if wheel > 0.0 {
            preview_set_zoom(st, st->preview_zoom * 1.12)
        } else if wheel < 0.0 {
            preview_set_zoom(st, st->preview_zoom * 0.90)
        }
        if IsMouseButtonDown(MOUSE_BUTTON_MIDDLE) || IsMouseButtonDown(MOUSE_BUTTON_RIGHT) {
            delta := GetMouseDelta()
            st->preview_pan_x = st->preview_pan_x + delta.x
            st->preview_pan_y = st->preview_pan_y + delta.y
            st->preview_scale_mode = state.IDE_PREVIEW_SCALE_CUSTOM
        }
    }
    draw_w := (float)pw * scale
    draw_h := (float)ph * scale
    dst := (Rectangle){content.x + (content.width - draw_w) * 0.5 + st->preview_pan_x,
                       content.y + (content.height - draw_h) * 0.5 + st->preview_pan_y,
                       draw_w, draw_h}
    BeginScissorMode((int)content.x, (int)content.y,
                     (int)content.width, (int)content.height)
    DrawTexturePro(st->preview_texture.texture,
                   (Rectangle){0, 0, (float)pw, -(float)ph},
                   dst, (Vector2){0, 0}, 0.0, WHITE)
    EndScissorMode()
}
