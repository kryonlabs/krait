#module "ide.text_view"
#import "kryon.h"
#import <string.h>
state :: #import "ide/state"
ed :: #import "ide/editor"
mods :: #import "ide/modules"

krait_scratch_path :: (out: char*, cap: int) -> int #extern

# Notepad mode: the active file as one plain full-window text area - no
# panes, no tabs, no toolbars. Esc returns to the studio; Ctrl+S saves
# through the normal editor path so dirty state and reloads stay honest.

draw_text_view :: (bounds: Rectangle, st: state.IdeState*) {
    text_view_ensure_file(st)
    DrawRectangleRec(bounds, GetThemeBackground())
    f := state.active_file(st)
    if f == NULL {
        Text("Open a file from the studio tree first", 
                   (int)bounds.x + ScaleUIPx(16),
                   (int)bounds.y + ScaleUIPx(16), ScaleUIPx(14),
                   GetThemeIcon())
        return
    }

    footer_h := ScaleUIPx(24)
    body := (Rectangle){bounds.x, bounds.y, bounds.width,
                        bounds.height - (float)footer_h}
    style := (TextInputStyle){
        GetThemeBackground(), GetThemeBackground(), GetThemeLink(),
        GetThemeText(), GetThemeText(), 0, ScaleUIPx(16), ScaleUIPx(10)
    }
    before_len := strlen(f->source)
    changed := TextArea((TextAreaProps){
        body, f->source, sizeof(f->source),
        &f->cursor, &f->focused, &f->scroll,
        sizeof(f->source) - 1, ScaleUIPx(14), ScaleUIPx(6), 7701,
        "Type", SyntaxNone, style, (TextInputFilter){0}, NULL, 0
    })
    if changed != 0 || strlen(f->source) != before_len {
        if f->dirty == 0 {
            f->dirty = 1
        }
        f->revision = f->revision + 1
    }
    if f->focused != 0 {
        st->console_focused = 0
    }

    mod := IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL) ||
           IsKeyDown(KEY_LEFT_SUPER) || IsKeyDown(KEY_RIGHT_SUPER)
    if mod && IsKeyPressed(KEY_S) {
        ed.editor_save_active(st)
    }
    if IsKeyPressed(KEY_ESCAPE) && f->focused == 0 {
        if st->project.loaded != 0 {
            st->view = state.IDE_VIEW_PROJECT
        } else {
            st->picker_open = 1
        }
        return
    }
    if IsKeyPressed(KEY_ESCAPE) && f->focused != 0 {
        f->focused = 0
    }

    DrawRectangle((int)bounds.x, (int)(bounds.y + bounds.height) - footer_h,
                  (int)bounds.width, footer_h, GetThemeSurface())
    foot: [300] char
    snprintf(foot, sizeof(foot), "%s%s  -  Esc: %s  Ctrl+S: save",
             f->name, f->dirty != 0 ? " *" : "",
             st->project.loaded != 0 ? "studio" : "projects")
    Text(foot, (int)bounds.x + ScaleUIPx(10),
               (int)(bounds.y + bounds.height) - footer_h + ScaleUIPx(5),
               ScaleUIPx(11), GetThemeIcon())
}

# entering text mode with nothing open: with a project, fall back to its
# preferred startup file; without one, edit a persistent scratch buffer so
# krait works as a fresh text editor out of the box
text_view_ensure_file :: (st: state.IdeState*) {
    if state.active_file(st) != NULL {
        return
    }
    if st->project.loaded != 0 {
        startup: [1024] char
        if mods.preferred_startup_file(st, startup, sizeof(startup)) {
            ed.editor_open(st, startup)
        }
        return
    }
    if st->open_count >= 12 {
        return
    }
    scratch: [1024] char
    if krait_scratch_path(scratch, sizeof(scratch)) == 0 {
        return
    }
    slot := &st->open_files[st->open_count]
    memset(slot, 0, sizeof(state.OpenFile))
    slot->source[0] = 0
    n := kry_fs_read_file(scratch, slot->source, sizeof(slot->source))
    if n < 0 {
        slot->source[0] = 0
    }
    snprintf(slot->name, sizeof(slot->name), "Untitled")
    snprintf(slot->path, sizeof(slot->path), "%s", scratch)
    slot->used = 1
    slot->artifact_tab = state.IDE_ARTIFACT_KRY
    slot->artifact_kind = state.IDE_ARTIFACT_KRY
    st->active_open = st->open_count
    st->open_count = st->open_count + 1
}
