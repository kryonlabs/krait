#module "ide.start_page"
#import "kryon.h"
state :: #import "ide/state"
proj :: #import "ide/project"
mods :: #import "ide/modules"

krait_recent_count :: () -> int #extern
krait_recent_path :: (index: int, out: char*, cap: int) -> int #extern
krait_recent_remove :: (index: int) #extern
krait_example_count :: () -> int #extern
krait_example_path :: (index: int, out: char*, cap: int) -> int #extern
krait_example_title :: (index: int, out: char*, cap: int) -> int #extern

#private

path_basename :: (dst: char*, dst_size: int, path: const char*) {
    base := path
    p := path
    while *p != 0 {
        if *p == '/' {
            base = p + 1
        }
        p = p + 1
    }
    snprintf(dst, dst_size, "%s", base)
}

draw_project_card :: (x: int, y: int, w: int, h: int,
                      title: const char*, path: const char*,
                      block_x: int, block_y: int,
                      block_w: int, block_h: int) -> int {
    mouse := GetMousePosition()
    blocked := block_w > 0 && block_h > 0 &&
               CheckCollisionPointRec(mouse, (Rectangle){
                   (float)block_x, (float)block_y,
                   (float)block_w, (float)block_h
               })

    DrawRectangle(x, y, w, h, GetThemeSurface())
    DrawRectangleLines(x, y, w, h, GetThemeButton())
    Text(title, x + ScaleUIPx(12), y + ScaleUIPx(10),
               ScaleUIPx(15), GetThemeText())
    Text(path, x + ScaleUIPx(12), y + ScaleUIPx(34),
               ScaleUIPx(11), GetThemeIcon())
    return !blocked &&
           CheckCollisionPointRec(mouse,
                                  (Rectangle){(float)x, (float)y,
                                              (float)w, (float)h}) &&
           IsMouseButtonPressed(MOUSE_BUTTON_LEFT)
}

draw_recent_projects :: (x0: int, y0: int, card_w: int, card_h: int,
                         gap: int, st: state.IdeState*) -> int {
    y := y0
    recent_count := krait_recent_count()
    Text("Recent Projects", x0, y, ScaleUIPx(18), GetThemeText())
    y = y + ScaleUIPx(30)
    if recent_count == 0 {
        Text("No recent projects yet - open or create one.",
                   x0, y, ScaleUIPx(13), GetThemeIcon())
        return y + ScaleUIPx(34)
    }
    for int i = 0; i < recent_count; i++ {
        path: [1024] char
        title: [256] char
        if krait_recent_path(i, path, sizeof(path)) == 0 {
            continue
        }
        path_basename(title, sizeof(title), path)
        card_x := x0 + (i % 2) * (card_w + gap)
        card_y := y + (i / 2) * (card_h + gap)
        remove_x := card_x + card_w - ScaleUIPx(32)
        remove_y := card_y + ScaleUIPx(8)
        remove_size := ScaleUIPx(22)
        if draw_project_card(card_x, card_y, card_w, card_h, title, path,
                             remove_x, remove_y, remove_size, remove_size) {
            proj.project_open(st, path)
            return -1
        }
        if StyledButton(remove_x, remove_y, remove_size, remove_size, "x",
                               ButtonStyleSecondary, 0, NULL) {
            krait_recent_remove(i)
            state.project_set_status(st, "Removed recent project")
            return -1
        }
    }
    return y + ((recent_count + 1) / 2) * (card_h + gap) + ScaleUIPx(18)
}

draw_examples :: (x0: int, y0: int, card_w: int, card_h: int, gap: int,
                 bottom: int, st: state.IdeState*) {
    y := y0
    example_count := krait_example_count()
    Text("Examples", x0, y, ScaleUIPx(18), GetThemeText())
    y = y + ScaleUIPx(30)
    if example_count == 0 {
        Text("No examples found.", x0, y, ScaleUIPx(13), GetThemeIcon())
        return
    }
    for int i = 0; i < example_count; i++ {
        path: [1024] char
        title: [256] char
        if krait_example_path(i, path, sizeof(path)) == 0 {
            continue
        }
        if krait_example_title(i, title, sizeof(title)) == 0 {
            path_basename(title, sizeof(title), path)
        }
        card_x := x0 + (i % 2) * (card_w + gap)
        card_y := y + (i / 2) * (card_h + gap)
        if card_y + card_h > bottom {
            break
        }
        if draw_project_card(card_x, card_y, card_w, card_h, title, path,
                             0, 0, 0, 0) {
            proj.project_open(st, path)
            return
        }
    }
}

#global

draw_start_page :: (content: Rectangle, st: state.IdeState*) {
    pad := ScaleUIPx(40)
    x0 := (int)content.x + pad
    y := (int)content.y + ScaleUIPx(48)
    card_w := ScaleUIPx(280)
    card_h := ScaleUIPx(70)
    gap := ScaleUIPx(14)
    bottom := (int)(content.y + content.height - pad)

    Text("Krait", x0, y, ScaleUIPx(32), GetThemeText())
    y = y + ScaleUIPx(42)
    Text("Choose a project to begin, or start something new.",
               x0, y, ScaleUIPx(14), GetThemeIcon())
    y = y + ScaleUIPx(34)
    if StyledButton(x0, y, ScaleUIPx(180), ScaleUIPx(42),
                           "Open Project", ButtonStylePrimary, 0, NULL) {
        st->dialog_mode = state.IDE_DIALOG_OPEN_PROJECT
    }
    if mods.has_project_templates(st) != 0 {
        if StyledButton(x0 + ScaleUIPx(194), y,
                               ScaleUIPx(180), ScaleUIPx(42), "New Project",
                               ButtonStyleSecondary, 0, NULL) {
            st->dialog_mode = state.IDE_DIALOG_NEW_PROJECT
        }
    }
    y = y + ScaleUIPx(70)

    y = draw_recent_projects(x0, y, card_w, card_h, gap, st)
    if y < 0 {
        return
    }
    if mods.has_project_templates(st) != 0 {
        draw_examples(x0, y, card_w, card_h, gap, bottom, st)
    }
}

# Project picker as an in-app modal (kanban card modal pattern): available
# from any view so the app can launch straight into text/kanban/agent and
# pick a project later.
draw_project_picker_modal :: (bounds: Rectangle, st: state.IdeState*) {
    w := (int)bounds.width - ScaleUIPx(160)
    if w > ScaleUIPx(760) {
        w = ScaleUIPx(760)
    }
    if w < ScaleUIPx(420) {
        w = ScaleUIPx(420)
    }
    h := (int)bounds.height - ScaleUIPx(100)
    if h > ScaleUIPx(680) {
        h = ScaleUIPx(680)
    }
    if h < ScaleUIPx(360) {
        h = ScaleUIPx(360)
    }
    frame := ModalFrame(w, h, "Open Project",
                        (Texture2D){0}, (Texture2D){0})
    if IsKeyPressed(KEY_ESCAPE) ||
       (IsMouseButtonPressed(MOUSE_BUTTON_LEFT) &&
        !CheckCollisionPointRec(GetMousePosition(),
                                (Rectangle){(float)frame.x, (float)frame.y,
                                            (float)frame.w, (float)frame.h})) {
        st->picker_open = 0
        return
    }
    content := (Rectangle){(float)frame.content_x, (float)frame.content_y,
                           (float)frame.content_w, (float)frame.content_h}
    draw_picker_body(content, st)
}

draw_picker_body :: (bounds: Rectangle, st: state.IdeState*) {
    pad := ScaleUIPx(16)
    x0 := (int)bounds.x + pad
    y := (int)bounds.y + ScaleUIPx(10)
    card_w := (int)bounds.width / 2 - pad - ScaleUIPx(8)
    if card_w > ScaleUIPx(300) {
        card_w = ScaleUIPx(300)
    }
    card_h := ScaleUIPx(70)
    gap := ScaleUIPx(14)
    bottom := (int)(bounds.y + bounds.height - pad)

    if StyledButton(x0, y, ScaleUIPx(150), ScaleUIPx(34),
                           "Browse...", ButtonStylePrimary, 0, NULL) {
        st->dialog_mode = state.IDE_DIALOG_OPEN_PROJECT
        st->picker_open = 0
        return
    }
    if mods.has_project_templates(st) != 0 {
        if StyledButton(x0 + ScaleUIPx(162), y,
                               ScaleUIPx(150), ScaleUIPx(34), "New Project",
                               ButtonStyleSecondary, 0, NULL) {
            st->dialog_mode = state.IDE_DIALOG_NEW_PROJECT
            st->picker_open = 0
            return
        }
    }
    y = y + ScaleUIPx(52)

    y = draw_recent_projects(x0, y, card_w, card_h, gap, st)
    if y < 0 {
        return
    }
    if mods.has_project_templates(st) != 0 {
        draw_examples(x0, y, card_w, card_h, gap, bottom, st)
    }
}
