#module "ide.state"
#import "kryon.h"

#enum {
    IDE_LAYOUT_SPLIT,
    IDE_LAYOUT_SOURCE,
    IDE_LAYOUT_PREVIEW,
}

#enum {
    IDE_BOTTOM_NONE,
    IDE_BOTTOM_PROBLEMS,
    IDE_BOTTOM_OUTPUT,
    IDE_BOTTOM_CONSOLE,
    IDE_BOTTOM_SEARCH,
}

#enum {
    IDE_PANE_LEFT,
    IDE_PANE_CENTER,
    IDE_PANE_RIGHT,
    IDE_PANE_BOTTOM,
}

#enum {
    IDE_PANE_VIEW_EXPLORER,
    IDE_PANE_VIEW_EDITOR,
    IDE_PANE_VIEW_PREVIEW,
    IDE_PANE_VIEW_PROBLEMS,
    IDE_PANE_VIEW_OUTPUT,
    IDE_PANE_VIEW_CONSOLE,
    IDE_PANE_VIEW_SEARCH,
}

#enum {
    IDE_VIEW_START,
    IDE_VIEW_PROJECT,
}

#enum {
    IDE_DIALOG_NONE,
    IDE_DIALOG_OPEN_PROJECT,
    IDE_DIALOG_NEW_PROJECT,
}

#enum {
    IDE_PREVIEW_SCALE_FIT,
    IDE_PREVIEW_SCALE_CUSTOM,
}

Diagnostic :: struct {
    path: [512] char
    line: int
    column: int
    message: [512] char
}

SearchResult :: struct {
    path: [512] char
    line: int
    excerpt: [256] char
}

FileTreeEntry :: struct {
    label: [256] char
    path: [1024] char
    depth: int
    is_dir: int
    id: int
}

Project :: struct {
    loaded: int
    path: [1024] char
    name: [256] char
}

PaneGroup :: struct {
    tabs: [8] int
    tab_count: int
    active: int
}

OpenFile :: struct {
    used: int
    name: [256] char
    path: [1024] char
    source: [131072] char
    cursor: int
    focused: int
    scroll: int
    dirty: int
    undo_head: int
    undo_count: int
    redo_count: int
}

IdeState :: struct {
    view: int
    layout_mode: int
    bottom_panel: int
    panes_initialized: int
    pane_left: PaneGroup
    pane_center: PaneGroup
    pane_right: PaneGroup
    pane_bottom: PaneGroup
    left_width: int
    right_width: int
    bottom_height: int
    resizing_pane: int
    active_pane: int
    layout_dirty: int
    status: [256] char
    project: Project
    dialog_mode: int
    # file tree
    entries: [1024] FileTreeEntry
    entry_count: int
    selected_entry: int
    activated_entry: int
    expanded_entries: [256] int
    expanded_count: int
    tree_scroll: int
    # open files / tabs
    open_files: [12] OpenFile
    open_count: int
    active_open: int
    # find bar
    find_visible: int
    find_text: [256] char
    find_cursor: int
    find_focused: int
    # preview / build
    host_library: void*
    host: AppHost*
    build_proc: KryProcess
    build_running: int
    preview_texture: RenderTexture2D
    preview_texture_w: int
    preview_texture_h: int
    preview_zoom: float
    preview_pan_x: float
    preview_pan_y: float
    preview_scale_mode: int
    output: [65536] char
    source_mtime: long
    last_reload_check: float
    # console
    console_proc: KryProcess
    console_running: int
    console_output: [65536] char
    console_input: [512] char
    console_cursor: int
    console_focused: int
    console_scroll: int
    # problems
    diagnostics: [64] Diagnostic
    diagnostic_count: int
    selected_diagnostic: int
    # search / quick open
    search_results: [64] SearchResult
    search_count: int
    selected_search: int
    search_scroll: int
    quick_open_mode: int
    # bottom panel
    bottom_visible: int
    bottom_tab: int
}

project_set_status :: (st: IdeState*, msg: const char*) {
    snprintf(st->status, sizeof(st->status), "%s", msg)
}

active_file :: (st: IdeState*) -> OpenFile* {
    if st->active_open < 0 {
        return NULL
    }
    if st->active_open >= st->open_count {
        return NULL
    }
    return &st->open_files[st->active_open]
}
