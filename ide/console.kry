#module "ide.console"
#import "kryon.h"
#import <string.h>
state :: #import "ide/state"

#global

console_ensure :: (st: state.IdeState*, cols: int, rows: int) {
    if st->term.running {
        KryTermResize(&st->term, cols, rows)
        return
    }
    cwd := st->project.loaded ? st->project.path : GetWorkingDirectory()
    if KryTermSpawn(&st->term, cwd, cols, rows) {
        state.project_set_status(st, "Terminal ready")
    } else {
        state.project_set_status(st, "Could not start terminal")
    }
}

console_poll :: (st: state.IdeState*) {
    if st->term.fd > 0 {
        KryTermPoll(&st->term)
    }
}

console_stop :: (st: state.IdeState*) {
    KryTermClose(&st->term)
    st->console_focused = 0
    state.project_set_status(st, "Terminal closed")
}

console_send :: (st: state.IdeState*, text: const char*) {
    if text == NULL || text[0] == 0 {
        return
    }
    console_ensure(st, 80, 24)
    KryTermWrite(&st->term, text, (int)strlen(text))
}

console_run_build :: (st: state.IdeState*) {
    console_send(st, "make\n")
}

console_run_app :: (st: state.IdeState*) {
    console_send(st, "make run\n")
}

console_focus :: (st: state.IdeState*) {
    st->console_focused = 1
    for int i = 0; i < st->open_count; i++ {
        st->open_files[i].focused = 0
    }
}

feed_keys :: (st: state.IdeState*) {
    ch := 0
    seq: [8] char

    if IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL) {
        if IsKeyPressed(KEY_C) {
            KryTermWrite(&st->term, "\x03", 1)
        }
        if IsKeyPressed(KEY_D) {
            KryTermWrite(&st->term, "\x04", 1)
        }
        if IsKeyPressed(KEY_L) {
            KryTermWrite(&st->term, "\x0c", 1)
        }
    }
    if IsKeyPressed(KEY_ENTER) {
        KryTermWrite(&st->term, "\r", 1)
    }
    if IsKeyPressed(KEY_BACKSPACE) {
        KryTermWrite(&st->term, "\x7f", 1)
    }
    if IsKeyPressed(KEY_TAB) {
        KryTermWrite(&st->term, "\t", 1)
    }
    if IsKeyPressed(KEY_UP) {
        KryTermWrite(&st->term, "\x1b[A", 3)
    }
    if IsKeyPressed(KEY_DOWN) {
        KryTermWrite(&st->term, "\x1b[B", 3)
    }
    if IsKeyPressed(KEY_RIGHT) {
        KryTermWrite(&st->term, "\x1b[C", 3)
    }
    if IsKeyPressed(KEY_LEFT) {
        KryTermWrite(&st->term, "\x1b[D", 3)
    }
    if IsKeyPressed(KEY_HOME) {
        KryTermWrite(&st->term, "\x1b[H", 3)
    }
    if IsKeyPressed(KEY_END) {
        KryTermWrite(&st->term, "\x1b[F", 3)
    }
    ch = GetCharPressed()
    while ch > 0 {
        if ch >= 32 && ch < 127 {
            seq[0] = (char)ch
            KryTermWrite(&st->term, seq, 1)
        }
        ch = GetCharPressed()
    }
}

draw_console :: (bounds: Rectangle, st: state.IdeState*) {
    pad := ScaleUIPx(6)
    bar_h := ScaleUIPx(26)
    gap := ScaleUIPx(6)
    btn_w := ScaleUIPx(52)
    font := ScaleUIPx(13)
    cell_w := MeasureUIText("M", font)
    if cell_w < 6 {
        cell_w = font * 6 / 10
    }
    line_h := font + ScaleUIPx(2)
    term := (Rectangle){bounds.x + (float)pad,
                        bounds.y + (float)(bar_h + gap),
                        bounds.width - (float)(pad * 2),
                        bounds.height - (float)(bar_h + gap + pad)}
    cols := (int)term.width / cell_w
    rows := (int)term.height / line_h
    x := (int)bounds.x + pad
    y := (int)bounds.y
    line: [256] char
    row := 0
    cursor_on := 0

    console_ensure(st, cols, rows)
    if DrawUIGenericButton(x, y, btn_w, bar_h, "Build",
                           UI_BUTTON_STYLE_PRIMARY, 0, NULL) {
        console_run_build(st)
        console_focus(st)
    }
    if DrawUIGenericButton(x + btn_w + gap, y, btn_w, bar_h, "Run",
                           UI_BUTTON_STYLE_PRIMARY, 0, NULL) {
        console_run_app(st)
        console_focus(st)
    }
    if DrawUIGenericButton(x + (btn_w + gap) * 2, y, btn_w, bar_h, "Stop",
                           UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        console_stop(st)
    }
    DrawRectangleRec(term, GetThemeBackground())
    if CheckCollisionPointRec(GetMousePosition(), term) &&
       IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
        console_focus(st)
    }
    if st->console_focused != 0 {
        feed_keys(st)
    }
    for row = 0; row < st->term.rows; row++ {
        KryTermLine(&st->term, row, line, sizeof(line))
        DrawUIText(line, (int)term.x + 2,
                   (int)term.y + row * line_h, font, GetThemeText())
    }
    cursor_on = ((int)(GetTime() * 2.0) & 1) == 0
    if st->console_focused != 0 && cursor_on &&
       st->term.cx >= 0 && st->term.cy >= 0 {
        DrawRectangle((int)term.x + 2 + st->term.cx * cell_w,
                      (int)term.y + st->term.cy * line_h,
                      cell_w, line_h, GetThemeText())
    }
}
