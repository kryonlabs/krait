#module "ide.console"
#import "kryon.h"
#import <string.h>
state :: #import "ide/state"
prob :: #import "ide/problems"

kry_process_spawn :: (p: KryProcess*, command: const char*, cwd: const char*) -> int #extern
kry_process_read_poll :: (p: KryProcess*, buf: char*, cap: int) -> int #extern
kry_process_wait_poll :: (p: KryProcess*) -> int #extern
kry_process_kill :: (p: KryProcess*) #extern
kry_process_close :: (p: KryProcess*) #extern

#global

console_run :: (st: state.IdeState*) {
    if st->console_running {
        return
    }
    cmd: [768] char
    snprintf(cmd, sizeof(cmd), "%s", st->console_input)
    if kry_process_spawn(&st->console_proc, cmd, st->project.path) {
        st->console_running = 1
        state.project_set_status(st, "Console running")
    } else {
        state.project_set_status(st, "Could not start console")
    }
}

console_run_command :: (st: state.IdeState*, command: const char*) {
    if st->console_running {
        state.project_set_status(st, "Console busy")
        return
    }
    if kry_process_spawn(&st->console_proc, command, st->project.path) {
        st->console_running = 1
        st->console_output[0] = 0
        state.project_set_status(st, "Running: %s")
    } else {
        state.project_set_status(st, "Could not start command")
    }
}

console_run_build :: (st: state.IdeState*) {
    console_run_command(st, "make")
}

console_run_app :: (st: state.IdeState*) {
    console_run_command(st, "make run")
}

console_stop :: (st: state.IdeState*) {
    if !st->console_running {
        return
    }
    kry_process_kill(&st->console_proc)
    kry_process_close(&st->console_proc)
    st->console_running = 0
    state.project_set_status(st, "Console stopped")
}

console_poll :: (st: state.IdeState*) {
    if !st->console_running {
        return
    }
    buf: [4096] char
    drained := 0
    while drained == 0 {
        n := kry_process_read_poll(&st->console_proc, buf, sizeof(buf))
        if n <= 0 {
            drained = 1
        } else {
            cur := strlen(st->console_output)
            room := sizeof(st->console_output) - cur - 1
            if room > 0 {
                strncat(st->console_output, buf, room)
            }
        }
    }
    if kry_process_wait_poll(&st->console_proc) {
        st->console_running = 0
        if st->console_proc.exit_status != 0 {
            prob.problems_parse(st, st->console_output)
        }
        kry_process_close(&st->console_proc)
        state.project_set_status(st, "Console finished")
    }
}

draw_console :: (bounds: Rectangle, st: state.IdeState*) {
    input_h := ScaleUIPx(28)
    action_w := ScaleUIPx(58)
    btn_w := ScaleUIPx(52)
    gap := ScaleUIPx(6)
    box_style := (UITextInputStyle){
        GetThemeSurface(),
        GetThemeButton(),
        GetThemeLink(),
        GetThemeText(),
        GetThemeLink(),
        0,
        ScaleUIPx(10),
        ScaleUIPx(8)
    }
    input_style := (UITextInputStyle){
        GetThemeSurface(),
        GetThemeButton(),
        GetThemeLink(),
        GetThemeText(),
        GetThemeLink(),
        0,
        ScaleUIPx(10),
        ScaleUIPx(6)
    }
    btn_y := (int)bounds.y
    btn_x := (int)bounds.x
    if DrawUIGenericButton(btn_x, btn_y, btn_w, input_h,
                           "Build", UI_BUTTON_STYLE_PRIMARY, 0, NULL) {
        console_run_build(st)
    }
    if DrawUIGenericButton(btn_x + btn_w + gap, btn_y, btn_w, input_h,
                           "Run", UI_BUTTON_STYLE_PRIMARY, 0, NULL) {
        console_run_app(st)
    }
    row2_y := btn_y + input_h + gap
    input_bounds := (Rectangle){bounds.x, (float)row2_y,
                                bounds.width - (float)(action_w * 2 + gap * 2),
                                (float)input_h}
    stop_bounds := (Rectangle){input_bounds.x + input_bounds.width + (float)gap,
                               (float)row2_y, (float)action_w, (float)input_h}
    clear_bounds := (Rectangle){stop_bounds.x + stop_bounds.width + (float)gap,
                                (float)row2_y, (float)action_w, (float)input_h}
    log_bounds := (Rectangle){bounds.x, (float)(row2_y + input_h + gap),
                              bounds.width,
                              bounds.height - (float)(row2_y - (int)bounds.y) -
                                  (float)input_h - (float)gap}
    DrawUIReadonlyTextBox((ReadonlyTextBoxProps){
        log_bounds, st->console_output, ScaleUIPx(13),
        box_style, ScaleUIPx(4)
    })
    DrawUITextField((TextFieldProps){
        input_bounds, st->console_input, sizeof(st->console_input),
        &st->console_cursor, &st->console_focused,
        sizeof(st->console_input) - 1, ScaleUIPx(13), 4002,
        input_style, (UITextInputFilter){0}, NULL, NULL
    })
    if DrawUIGenericButton((int)stop_bounds.x, (int)stop_bounds.y,
                           (int)stop_bounds.width, (int)stop_bounds.height,
                           "Stop", UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        console_stop(st)
    }
    if DrawUIGenericButton((int)clear_bounds.x, (int)clear_bounds.y,
                           (int)clear_bounds.width, (int)clear_bounds.height,
                           "Clear", UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        st->console_output[0] = 0
        state.project_set_status(st, "Console cleared")
    }
    if st->console_focused != 0 && IsKeyPressed(KEY_ENTER) {
        if st->console_input[0] != 0 {
            console_run(st)
            st->console_input[0] = 0
        }
    }
}
