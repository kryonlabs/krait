#module "ide.console"
#import "kryon.h"
#import <string.h>
state :: #import "ide/state"

#global

console_ensure :: (st: state.IdeState*, cols: int, rows: int) {
    if st->term.running {
        TerminalResize(&st->term, cols, rows)
        return
    }
    cwd := st->project.loaded ? st->project.path : GetWorkingDirectory()
    if TerminalSpawn(&st->term, cwd, cols, rows) {
        state.project_set_status(st, "Terminal ready")
    } else {
        state.project_set_status(st, "Could not start terminal")
    }
}

console_poll :: (st: state.IdeState*) {
    if st->term.fd > 0 {
        TerminalPoll(&st->term)
    }
}

console_stop :: (st: state.IdeState*) {
    TerminalClose(&st->term)
    st->console_focused = 0
    state.project_set_status(st, "Terminal closed")
}

console_send :: (st: state.IdeState*, text: const char*) {
    if text == NULL || text[0] == 0 {
        return
    }
    console_ensure(st, 80, 24)
    TerminalWrite(&st->term, text, (int)strlen(text))
}

# harness-printed text (agent command output) shown like process output
console_feed :: (st: state.IdeState*, text: const char*) {
    if text == NULL || text[0] == 0 {
        return
    }
    console_ensure(st, 80, 24)
    TerminalFeedOutput(&st->term, text, (int)strlen(text))
}

console_run_build :: (st: state.IdeState*) {
    console_send(st, "make\n")
}

console_run_app :: (st: state.IdeState*) {
    console_send(st, "make run\n")
}

console_focus :: (st: state.IdeState*) {
    st->console_focused = 1
    for int i = 0; i < st->open_count; i++ {
        st->open_files[i].focused = 0
    }
}

draw_console :: (bounds: Rectangle, st: state.IdeState*) {
    pad := ScaleUIPx(6)
    bar_h := ScaleUIPx(26)
    gap := ScaleUIPx(6)
    btn_w := ScaleUIPx(52)
    font := ScaleUIPx(13)
    term := (Rectangle){bounds.x + (float)pad,
                        bounds.y + (float)(bar_h + gap),
                        bounds.width - (float)(pad * 2),
                        bounds.height - (float)(bar_h + gap + pad)}
    metrics := MeasureTerminalPane(term, font, pad)
    x := (int)bounds.x + pad
    y := (int)bounds.y
    pane: TerminalPane
    result: TerminalPaneResult

    console_ensure(st, metrics.cols, metrics.rows)
    if DrawUIGenericButton(x, y, btn_w, bar_h, "Build",
                           UI_BUTTON_STYLE_PRIMARY, 0, NULL) {
        console_run_build(st)
        console_focus(st)
    }
    if DrawUIGenericButton(x + btn_w + gap, y, btn_w, bar_h, "Run",
                           UI_BUTTON_STYLE_PRIMARY, 0, NULL) {
        console_run_app(st)
        console_focus(st)
    }
    if DrawUIGenericButton(x + (btn_w + gap) * 2, y, btn_w, bar_h, "Stop",
                           UI_BUTTON_STYLE_SECONDARY, 0, NULL) {
        console_stop(st)
    }

    memset(&pane, 0, sizeof(pane))
    pane.bounds = term
    pane.terminal = &st->term
    pane.focused = st->console_focused
    pane.font_size = font
    pane.padding = pad
    pane.show_cursor = 1
    pane.handle_input = st->console_focused
    result = DrawTerminalPane(pane)
    st->console_focused = result.focused
    if result.focused != 0 {
        for int i = 0; i < st->open_count; i++ {
            st->open_files[i].focused = 0
        }
    }
}
