#module "ide.console"
#import "kryon.h"
#import <string.h>
state :: #import "ide/state"

# The bottom-panel Kapsule tab: the full Kapsule terminal emulator, vendored
# at vendor/kapsule and driven natively from src/native_console.c. This module
# is only the IDE-side toolbar and focus glue.
krait_console_init :: () #extern
krait_console_shutdown :: () #extern
krait_console_running :: () -> int #extern
krait_console_ensure :: (cwd: const char*, cols: int, rows: int) -> int #extern
krait_console_ensure_cwd :: (cwd: const char*, cols: int, rows: int) -> int #extern
krait_console_restart :: (cwd: const char*) -> int #extern
krait_console_stop :: () #extern
krait_console_poll :: () #extern
krait_console_send :: (text: const char*) #extern
krait_console_feed :: (text: const char*) #extern
krait_console_draw :: (bounds: Rectangle, focused: int, font_size: int) -> int #extern
krait_console_copy :: () #extern
krait_console_paste :: () #extern
krait_console_title :: () -> const char* #extern

#global

console_init :: (st: state.IdeState*) {
    krait_console_init()
}

console_shutdown :: (st: state.IdeState*) {
    krait_console_shutdown()
    st->console_focused = 0
}

console_ensure :: (st: state.IdeState*, cols: int, rows: int) {
    if krait_console_running() != 0 {
        return
    }
    cwd := st->project.loaded ? st->project.path : GetWorkingDirectory()
    if krait_console_ensure(cwd, cols, rows) {
        state.project_set_status(st, "Kapsule terminal ready")
    } else {
        state.project_set_status(st, "Could not start terminal")
    }
}

console_poll :: (st: state.IdeState*) {
    krait_console_poll()
}

console_stop :: (st: state.IdeState*) {
    krait_console_stop()
    st->console_focused = 0
    state.project_set_status(st, "Terminal closed")
}

console_send :: (st: state.IdeState*, text: const char*) {
    if text == NULL || text[0] == 0 {
        return
    }
    console_ensure(st, 80, 24)
    krait_console_send(text)
}

console_ensure_project :: (st: state.IdeState*) -> int {
    cwd := st->project.loaded ? st->project.path : GetWorkingDirectory()
    if krait_console_ensure_cwd(cwd, 80, 24) {
        return 1
    }
    state.project_set_status(st, "Could not start terminal")
    return 0
}

# harness-printed text (agent command output) shown like process output
console_feed :: (st: state.IdeState*, text: const char*) {
    if text == NULL || text[0] == 0 {
        return
    }
    console_ensure(st, 80, 24)
    krait_console_feed(text)
}

console_run_build :: (st: state.IdeState*) {
    if console_ensure_project(st) == 0 {
        return
    }
    console_send(st, "make\n")
}

console_run_app :: (st: state.IdeState*) {
    if console_ensure_project(st) == 0 {
        return
    }
    console_send(st, "make run\n")
}

console_restart :: (st: state.IdeState*) {
    cwd := st->project.loaded ? st->project.path : GetWorkingDirectory()
    if krait_console_restart(cwd) {
        state.project_set_status(st, "Terminal restarted")
    } else {
        state.project_set_status(st, "Could not start terminal")
    }
    console_focus(st)
}

console_focus :: (st: state.IdeState*) {
    st->console_focused = 1
    for int i = 0; i < st->open_count; i++ {
        st->open_files[i].focused = 0
    }
}

draw_console :: (bounds: Rectangle, st: state.IdeState*) {
    pad := ScaleUIPx(6)
    bar_h := ScaleUIPx(26)
    gap := ScaleUIPx(6)
    btn_w := ScaleUIPx(58)
    font := ScaleUIPx(13)
    term := (Rectangle){bounds.x + (float)pad,
                        bounds.y + (float)(bar_h + gap),
                        bounds.width - (float)(pad * 2),
                        bounds.height - (float)(bar_h + gap + pad)}
    x := (int)bounds.x + pad
    y := (int)bounds.y

    console_ensure(st, 80, 24)
    if StyledButton(x, y, btn_w, bar_h, "Build",
                           ButtonStylePrimary, 0, NULL) {
        console_run_build(st)
        console_focus(st)
    }
    if StyledButton(x + btn_w + gap, y, btn_w, bar_h, "Run",
                           ButtonStylePrimary, 0, NULL) {
        console_run_app(st)
        console_focus(st)
    }
    if StyledButton(x + (btn_w + gap) * 2, y, btn_w, bar_h, "Restart",
                           ButtonStyleSecondary, 0, NULL) {
        console_restart(st)
    }
    if StyledButton(x + (btn_w + gap) * 3, y, btn_w, bar_h, "Stop",
                           ButtonStyleSecondary, 0, NULL) {
        console_stop(st)
    }
    if StyledButton(x + (btn_w + gap) * 4, y, btn_w, bar_h, "Copy",
                           ButtonStyleSecondary, 0, NULL) {
        krait_console_copy()
    }
    if StyledButton(x + (btn_w + gap) * 5, y, btn_w, bar_h, "Paste",
                           ButtonStyleSecondary, 0, NULL) {
        krait_console_paste()
        console_focus(st)
    }
    focused := krait_console_draw(term, st->console_focused, font)
    st->console_focused = focused
    if focused != 0 {
        for int i = 0; i < st->open_count; i++ {
            st->open_files[i].focused = 0
        }
    }
}
