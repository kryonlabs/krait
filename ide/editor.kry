#module "ide.editor"
#import "kryon.h"
#import <string.h>
#import <stdlib.h>
state :: #import "ide/state"
hx :: #import "ide/hex"
krait_hex_open :: (path: const char*) -> int #extern
mods :: #import "ide/modules"

kry_fs_read_file :: (path: const char*, buf: char*, cap: int) -> int #extern
kry_fs_write_file :: (path: const char*, text: const char*, len: int) -> int #extern
krait_artifact_generate :: (root: const char*, rel_source: const char*,
                            kind: int, out: char*, out_size: int,
                            artifact_path: char*, artifact_path_size: int,
                            status: char*, status_size: int) -> int #extern
krait_artifact_save_binary :: (generated_path: const char*,
                               dest_path: const char*) -> int #extern

#private

source_tabs :: [12] Tab #global
source_tab_labels :: [12][300] char #global
artifact_tabs :: [4] Tab #global
artifact_tab_labels :: [4][16] char #global

mod_key_down :: () -> int {
    return IsKeyDown(KEY_LEFT_CONTROL) || IsKeyDown(KEY_RIGHT_CONTROL) ||
           IsKeyDown(KEY_LEFT_SUPER) || IsKeyDown(KEY_RIGHT_SUPER)
}

shift_key_down :: () -> int {
    return IsKeyDown(KEY_LEFT_SHIFT) || IsKeyDown(KEY_RIGHT_SHIFT)
}

history_entry_clear :: (entry: state.EditorHistoryEntry*) {
    if entry == NULL {
        return
    }
    if entry->text != NULL {
        free(entry->text)
    }
    entry->text = NULL
    entry->cursor = 0
    entry->scroll = 0
    entry->revision = 0
}

editor_file_history_clear :: (f: state.OpenFile*) {
    if f == NULL {
        return
    }
    for int i = 0; i < f->undo_count; i++ {
        history_entry_clear(&f->undo[i])
    }
    for int i = 0; i < f->redo_count; i++ {
        history_entry_clear(&f->redo[i])
    }
    f->undo_count = 0
    f->redo_count = 0
    if f->snapshot_text != NULL {
        free(f->snapshot_text)
    }
    f->snapshot_text = NULL
    f->snapshot_valid = 0
    f->snapshot_cursor = 0
    f->snapshot_scroll = 0
    f->snapshot_revision = 0
    f->artifact_tab = state.IDE_ARTIFACT_KRY
    f->artifact_source[0] = 0
    f->artifact_name[0] = 0
    f->artifact_path[0] = 0
    f->artifact_cursor = 0
    f->artifact_focused = 0
    f->artifact_scroll = 0
    f->artifact_dirty = 0
    f->artifact_loaded = 0
    f->artifact_kind = state.IDE_ARTIFACT_KRY
    f->artifact_length = 0
    f->artifact_content_version = 1
    memset(&f->artifact_cache_source[0][0], 0, sizeof(f->artifact_cache_source))
    memset(&f->artifact_cache_name[0][0], 0, sizeof(f->artifact_cache_name))
    memset(&f->artifact_cache_path[0][0], 0, sizeof(f->artifact_cache_path))
    memset(&f->artifact_cache_length[0], 0, sizeof(f->artifact_cache_length))
    memset(&f->artifact_cache_content_version[0], 0, sizeof(f->artifact_cache_content_version))
    memset(&f->artifact_cache_cursor[0], 0, sizeof(f->artifact_cache_cursor))
    memset(&f->artifact_cache_scroll[0], 0, sizeof(f->artifact_cache_scroll))
    memset(&f->artifact_cache_dirty[0], 0, sizeof(f->artifact_cache_dirty))
    memset(&f->artifact_cache_loaded[0], 0, sizeof(f->artifact_cache_loaded))
}

editor_history_clear_redo :: (f: state.OpenFile*) {
    if f == NULL {
        return
    }
    for int i = 0; i < f->redo_count; i++ {
        history_entry_clear(&f->redo[i])
    }
    f->redo_count = 0
}

editor_snapshot_capture :: (f: state.OpenFile*) {
    if f == NULL {
        return
    }
    if f->snapshot_text != NULL {
        free(f->snapshot_text)
    }
    f->snapshot_text = strdup(f->source)
    f->snapshot_cursor = f->cursor
    f->snapshot_scroll = f->scroll
    f->snapshot_revision = f->revision
    f->snapshot_valid = f->snapshot_text != NULL ? 1 : 0
}

editor_snapshot_ensure :: (f: state.OpenFile*) {
    if f == NULL {
        return
    }
    if f->snapshot_valid == 0 {
        editor_snapshot_capture(f)
    }
}

editor_push_undo :: (f: state.OpenFile*, text: const char*, cursor: int,
                     scroll: int, revision: int) {
    if f == NULL || text == NULL {
        return
    }
    if f->undo_count > 0 {
        last := &f->undo[f->undo_count - 1]
        if last->text != NULL && strcmp(last->text, text) == 0 {
            last->cursor = cursor
            last->scroll = scroll
            last->revision = revision
            return
        }
    }
    if f->undo_count >= 64 {
        history_entry_clear(&f->undo[0])
        for int i = 0; i < 63; i++ {
            f->undo[i] = f->undo[i + 1]
        }
        f->undo[63] = (state.EditorHistoryEntry){0}
        f->undo_count = 63
    }
    f->undo[f->undo_count].text = strdup(text)
    f->undo[f->undo_count].cursor = cursor
    f->undo[f->undo_count].scroll = scroll
    f->undo[f->undo_count].revision = revision
    if f->undo[f->undo_count].text != NULL {
        f->undo_count = f->undo_count + 1
    }
}

editor_push_redo :: (f: state.OpenFile*, text: const char*, cursor: int,
                     scroll: int, revision: int) {
    if f == NULL || text == NULL {
        return
    }
    if f->redo_count >= 64 {
        history_entry_clear(&f->redo[0])
        for int i = 0; i < 63; i++ {
            f->redo[i] = f->redo[i + 1]
        }
        f->redo[63] = (state.EditorHistoryEntry){0}
        f->redo_count = 63
    }
    f->redo[f->redo_count].text = strdup(text)
    f->redo[f->redo_count].cursor = cursor
    f->redo[f->redo_count].scroll = scroll
    f->redo[f->redo_count].revision = revision
    if f->redo[f->redo_count].text != NULL {
        f->redo_count = f->redo_count + 1
    }
}

editor_apply_history_entry :: (f: state.OpenFile*, entry: state.EditorHistoryEntry*) {
    if f == NULL || entry == NULL || entry->text == NULL {
        return
    }
    snprintf(f->source, sizeof(f->source), "%s", entry->text)
    f->cursor = entry->cursor
    f->scroll = entry->scroll
    f->revision = entry->revision
    f->dirty = f->revision != f->saved_revision ? 1 : 0
    f->preview = 0
    editor_snapshot_capture(f)
}

editor_undo :: (st: state.IdeState*) {
    f := state.active_file(st)
    if f == NULL || f->undo_count == 0 {
        return
    }
    f->undo_count = f->undo_count - 1
    entry := f->undo[f->undo_count]
    f->undo[f->undo_count] = (state.EditorHistoryEntry){0}
    editor_push_redo(f, f->source, f->cursor, f->scroll, f->revision)
    editor_apply_history_entry(f, &entry)
    history_entry_clear(&entry)
    if mods.file_affects_preview(st, f->name) != 0 {
        st->preview_dirty = 1
        st->last_edit_time = GetTime()
    }
    state.project_set_status(st, "Undo")
}

editor_redo :: (st: state.IdeState*) {
    f := state.active_file(st)
    if f == NULL || f->redo_count == 0 {
        return
    }
    f->redo_count = f->redo_count - 1
    entry := f->redo[f->redo_count]
    f->redo[f->redo_count] = (state.EditorHistoryEntry){0}
    editor_push_undo(f, f->source, f->cursor, f->scroll, f->revision)
    editor_apply_history_entry(f, &entry)
    history_entry_clear(&entry)
    if mods.file_affects_preview(st, f->name) != 0 {
        st->preview_dirty = 1
        st->last_edit_time = GetTime()
    }
    state.project_set_status(st, "Redo")
}

editor_can_undo :: (st: state.IdeState*) -> int {
    f := state.active_file(st)
    if f == NULL {
        return 0
    }
    return f->undo_count > 0 ? 1 : 0
}

editor_can_redo :: (st: state.IdeState*) -> int {
    f := state.active_file(st)
    if f == NULL {
        return 0
    }
    return f->redo_count > 0 ? 1 : 0
}

#global

find_open_file :: (st: state.IdeState*, name: const char*) -> int {
    for int i = 0; i < st->open_count; i++ {
        if strcmp(st->open_files[i].name, name) == 0 {
            return i
        }
    }
    return -1
}

find_preview_file :: (st: state.IdeState*) -> int {
    for int i = 0; i < st->open_count; i++ {
        if st->open_files[i].preview != 0 {
            return i
        }
    }
    return -1
}

editor_load_into_slot :: (st: state.IdeState*, slot: state.OpenFile*,
                          name: const char*) -> int {
    full: [1024] char
    snprintf(full, sizeof(full), "%s/%s", st->project.path, name)
    editor_file_history_clear(slot)
    if hx.is_krb_file(name) != 0 {
        if krait_hex_open(full) == 0 {
            state.project_set_status(st, "Could not read file")
            return 0
        }
        slot->source[0] = 0
        snprintf(slot->name, sizeof(slot->name), "%s", name)
        snprintf(slot->path, sizeof(slot->path), "%s", full)
        slot->used = 1
        slot->cursor = 0
        slot->focused = 0
        slot->scroll = 0
        slot->dirty = 0
        slot->revision = 0
        slot->saved_revision = 0
        slot->artifact_tab = state.IDE_ARTIFACT_KRY
        slot->artifact_source[0] = 0
        slot->artifact_name[0] = 0
        slot->artifact_path[0] = 0
        slot->artifact_cursor = 0
        slot->artifact_focused = 0
        slot->artifact_scroll = 0
        return 1
    }
    n := kry_fs_read_file(full, slot->source, sizeof(slot->source))
    if n < 0 {
        state.project_set_status(st, "Could not read file")
        return 0
    }
    snprintf(slot->name, sizeof(slot->name), "%s", name)
    snprintf(slot->path, sizeof(slot->path), "%s", full)
    slot->used = 1
    slot->cursor = 0
    slot->focused = 0
    slot->scroll = 0
    slot->dirty = 0
    slot->revision = 0
    slot->saved_revision = 0
    slot->artifact_tab = state.IDE_ARTIFACT_KRY
    slot->artifact_source[0] = 0
    slot->artifact_name[0] = 0
    slot->artifact_path[0] = 0
    slot->artifact_cursor = 0
    slot->artifact_focused = 0
    slot->artifact_scroll = 0
    slot->artifact_dirty = 0
    slot->artifact_loaded = 0
    slot->artifact_kind = state.IDE_ARTIFACT_KRY
    state.project_set_status(st, full)
    editor_snapshot_capture(slot)
    return 1
}

editor_open_mode :: (st: state.IdeState*, name: const char*, preview: int) {
    existing := find_open_file(st, name)
    if existing >= 0 {
        st->active_open = existing
        if preview == 0 {
            st->open_files[existing].preview = 0
        }
        state.project_set_status(st, st->open_files[existing].path)
        if preview != 0 {
            st->focus_preview_pane = 1
        }
        return
    }
    if preview != 0 {
        st->focus_preview_pane = 1
    }
    if preview != 0 {
        preview_idx := find_preview_file(st)
            if preview_idx >= 0 && st->open_files[preview_idx].dirty == 0 {
            if editor_load_into_slot(st, &st->open_files[preview_idx], name) == 0 {
                return
            }
            st->open_files[preview_idx].preview = 1
            st->active_open = preview_idx
            return
        }
    }
    if st->open_count >= 12 {
        state.project_set_status(st, "Too many open files")
        return
    }
    slot := &st->open_files[st->open_count]
    if editor_load_into_slot(st, slot, name) == 0 {
        return
    }
    slot->preview = preview != 0 ? 1 : 0
    st->active_open = st->open_count
    st->open_count = st->open_count + 1
}

editor_open :: (st: state.IdeState*, name: const char*) {
    editor_open_mode(st, name, 0)
}

editor_open_line :: (st: state.IdeState*, name: const char*, line: int) {
    editor_open(st, name)
    idx := find_open_file(st, name)
    if idx < 0 { return }
    f := &st->open_files[idx]
    offset := 0
    row := 1
    while f->source[offset] != 0 && row < line {
        if f->source[offset] == 10 { row = row + 1 }
        offset = offset + 1
    }
    f->cursor = offset
    f->scroll = (row > 4 ? row - 4 : 0) * (TextLineHeight(ScaleUIPx(14)) + ScaleUIPx(6))
    f->focused = 1
    st->console_focused = 0
    SetUIFocus(3001)
}

editor_preview :: (st: state.IdeState*, name: const char*) {
    editor_open_mode(st, name, 1)
}

editor_pin_active :: (st: state.IdeState*) {
    f := state.active_file(st)
    if f == NULL {
        return
    }
    f->preview = 0
}

editor_close_active :: (st: state.IdeState*) {
    if st->active_open < 0 || st->active_open >= st->open_count {
        return
    }
    idx := st->active_open
    editor_file_history_clear(&st->open_files[idx])
    # shift later tabs down
    for int i = idx; i < st->open_count - 1; i++ {
        st->open_files[i] = st->open_files[i + 1]
    }
    st->open_count = st->open_count - 1
    if st->open_count >= 0 && st->open_count < 12 {
        memset(&st->open_files[st->open_count], 0, sizeof(state.OpenFile))
    }
    if st->active_open >= st->open_count {
        st->active_open = st->open_count - 1
    }
}

editor_save_active :: (st: state.IdeState*) {
    f := state.active_file(st)
    if f == NULL {
        return
    }
    if hx.is_krb_file(f->name) != 0 {
        hx.hex_save(st)
        return
    }
    if f->artifact_tab != state.IDE_ARTIFACT_KRY {
        editor_save_artifact(st, f)
        return
    }
    len := strlen(f->source)
    if kry_fs_write_file(f->path, f->source, len) < 0 {
        state.project_set_status(st, "Save failed")
        return
    }
    f->dirty = 0
    f->saved_revision = f->revision
    state.project_set_status(st, "Saved")
}

editor_reload_if_open :: (st: state.IdeState*, name: const char*) {
    idx := find_open_file(st, name)
    if idx < 0 {
        return
    }
    f := &st->open_files[idx]
    if f->dirty != 0 {
        state.project_set_status(st, "File changed on disk; unsaved editor changes preserved")
        return
    }
    if hx.is_krb_file(name) != 0 {
        krait_hex_open(f->path)
        state.project_set_status(st, "Reloaded (hex)")
        return
    }
    n := kry_fs_read_file(f->path, f->source, sizeof(f->source))
    if n < 0 {
        state.project_set_status(st, "Could not reload file")
        return
    }
    f->dirty = 0
    f->revision = 0
    f->saved_revision = 0
    f->cursor = 0
    f->scroll = 0
    editor_file_history_clear(f)
    editor_snapshot_capture(f)
}

editor_save_dirty_preview_files :: (st: state.IdeState*) -> int {
    saved := 0
    for int i = 0; i < st->open_count; i++ {
        f := &st->open_files[i]
        if f->dirty == 0 || mods.file_affects_preview(st, f->name) == 0 {
            continue
        }
        len := strlen(f->source)
        if kry_fs_write_file(f->path, f->source, len) < 0 {
            state.project_set_status(st, "Live preview save failed")
            return -1
        }
        f->dirty = 0
        f->saved_revision = f->revision
        saved = saved + 1
    }
    return saved
}

is_kry_file :: (name: const char*) -> int {
    len := strlen(name)
    return len >= 4 && strcmp(name + len - 4, ".kry") == 0
}

artifact_ext :: (kind: int) -> const char* {
    if kind == state.IDE_ARTIFACT_KIR {
        return ".kir"
    }
    if kind == state.IDE_ARTIFACT_KRB {
        return ".krb"
    }
    if kind == state.IDE_ARTIFACT_C {
        return ".c"
    }
    return ".kry"
}

artifact_label :: (kind: int) -> const char* {
    if kind == state.IDE_ARTIFACT_KIR {
        return "kir"
    }
    if kind == state.IDE_ARTIFACT_KRB {
        return "krb"
    }
    if kind == state.IDE_ARTIFACT_C {
        return "c"
    }
    return "kry"
}

artifact_kind_valid :: (kind: int) -> int {
    return kind >= state.IDE_ARTIFACT_KRY && kind <= state.IDE_ARTIFACT_C ? 1 : 0
}

artifact_mark_content_changed :: (f: state.OpenFile*) {
    if f == NULL {
        return
    }
    f->artifact_content_version = f->artifact_content_version + 1
    if f->artifact_content_version <= 0 {
        f->artifact_content_version = 1
    }
}

artifact_cache_store_active :: (f: state.OpenFile*) {
    if f == NULL || artifact_kind_valid(f->artifact_kind) == 0 ||
       f->artifact_loaded == 0 {
        return
    }
    kind := f->artifact_kind
    snprintf(f->artifact_cache_source[kind],
             sizeof(f->artifact_cache_source[kind]), "%s", f->artifact_source)
    snprintf(f->artifact_cache_name[kind],
             sizeof(f->artifact_cache_name[kind]), "%s", f->artifact_name)
    snprintf(f->artifact_cache_path[kind],
             sizeof(f->artifact_cache_path[kind]), "%s", f->artifact_path)
    f->artifact_cache_length[kind] = f->artifact_length
    f->artifact_cache_content_version[kind] = f->artifact_content_version
    f->artifact_cache_cursor[kind] = f->artifact_cursor
    f->artifact_cache_scroll[kind] = f->artifact_scroll
    f->artifact_cache_dirty[kind] = f->artifact_dirty
    f->artifact_cache_loaded[kind] = 1
}

artifact_cache_restore :: (f: state.OpenFile*, kind: int) -> int {
    if f == NULL || artifact_kind_valid(kind) == 0 ||
       f->artifact_cache_loaded[kind] == 0 {
        return 0
    }
    snprintf(f->artifact_source, sizeof(f->artifact_source), "%s",
             f->artifact_cache_source[kind])
    snprintf(f->artifact_name, sizeof(f->artifact_name), "%s",
             f->artifact_cache_name[kind])
    snprintf(f->artifact_path, sizeof(f->artifact_path), "%s",
             f->artifact_cache_path[kind])
    f->artifact_length = f->artifact_cache_length[kind]
    f->artifact_content_version = f->artifact_cache_content_version[kind]
    if f->artifact_content_version <= 0 {
        f->artifact_content_version = 1
    }
    f->artifact_cursor = f->artifact_cache_cursor[kind]
    f->artifact_scroll = f->artifact_cache_scroll[kind]
    f->artifact_dirty = f->artifact_cache_dirty[kind]
    f->artifact_loaded = 1
    f->artifact_kind = kind
    return 1
}

artifact_cache_invalidate :: (f: state.OpenFile*) {
    if f == NULL {
        return
    }
    f->artifact_loaded = 0
    f->artifact_dirty = 0
    f->artifact_length = 0
    artifact_mark_content_changed(f)
    for int i = 0; i < 4; i++ {
        f->artifact_cache_loaded[i] = 0
        f->artifact_cache_dirty[i] = 0
        f->artifact_cache_source[i][0] = 0
        f->artifact_cache_name[i][0] = 0
        f->artifact_cache_path[i][0] = 0
        f->artifact_cache_length[i] = 0
        f->artifact_cache_content_version[i] = 0
        f->artifact_cache_cursor[i] = 0
        f->artifact_cache_scroll[i] = 0
    }
}

artifact_dest_path :: (st: state.IdeState*, f: state.OpenFile*, kind: int,
                       out: char*, out_size: int) {
    snprintf(out, out_size, "%s/%s", st->project.path, f->name)
    len := strlen(out)
    if len >= 4 && strcmp(out + len - 4, ".kry") == 0 {
        out[len - 4] = 0
    }
    snprintf(out + strlen(out), out_size - strlen(out), "%s", artifact_ext(kind))
}

artifact_generate :: (st: state.IdeState*, f: state.OpenFile*, kind: int) -> int {
    status: [256] char

    if f == NULL || kind == state.IDE_ARTIFACT_KRY {
        return 1
    }
    if f->artifact_loaded != 0 && f->artifact_kind == kind {
        return 1
    }
    artifact_cache_store_active(f)
    if artifact_cache_restore(f, kind) != 0 {
        return 1
    }
    f->artifact_source[0] = 0
    f->artifact_name[0] = 0
    f->artifact_path[0] = 0
    f->artifact_cursor = 0
    f->artifact_scroll = 0
    f->artifact_focused = 0
    f->artifact_length = 0
    artifact_mark_content_changed(f)
    if krait_artifact_generate(st->project.path, f->name, kind,
                               f->artifact_source, sizeof(f->artifact_source),
                               f->artifact_path, sizeof(f->artifact_path),
                               status, sizeof(status)) == 0 {
        snprintf(f->artifact_source, sizeof(f->artifact_source),
                 "Could not generate %s artifact.\n%s\n",
                 artifact_label(kind), status)
        f->artifact_loaded = 1
        f->artifact_dirty = 0
        f->artifact_kind = kind
        f->artifact_length = (int)strlen(f->artifact_source)
        artifact_mark_content_changed(f)
        artifact_cache_store_active(f)
        state.project_set_status(st, "Artifact generation failed")
        return 0
    }
    snprintf(f->artifact_name, sizeof(f->artifact_name), "%s%s",
             f->name, artifact_ext(kind))
    f->artifact_loaded = 1
    f->artifact_dirty = 0
    f->artifact_kind = kind
    f->artifact_length = (int)strlen(f->artifact_source)
    artifact_mark_content_changed(f)
    artifact_cache_store_active(f)
    state.project_set_status(st, status)
    return 1
}

editor_save_artifact :: (st: state.IdeState*, f: state.OpenFile*) {
    dest: [1024] char
    kind := f->artifact_tab

    artifact_generate(st, f, kind)
    artifact_dest_path(st, f, kind, dest, sizeof(dest))
    if kind == state.IDE_ARTIFACT_KRB {
        if krait_artifact_save_binary(f->artifact_path, dest) == 0 {
            state.project_set_status(st, "KRB save failed")
            return
        }
    } else {
        if f->artifact_length < 0 {
            f->artifact_length = (int)strlen(f->artifact_source)
        }
        if kry_fs_write_file(dest, f->artifact_source, f->artifact_length) < 0 {
            state.project_set_status(st, "Artifact save failed")
            return
        }
    }
    f->artifact_dirty = 0
    artifact_cache_store_active(f)
    state.project_set_status(st, "Artifact saved")
}

draw_artifact_tabs :: (bounds: Rectangle, st: state.IdeState*,
                       f: state.OpenFile*) {
    if f == NULL || is_kry_file(f->name) == 0 {
        return
    }
    for int i = 0; i < 4; i++ {
        kind := i
        if kind == f->artifact_tab && f->artifact_dirty != 0 {
            snprintf(artifact_tab_labels[i], sizeof(artifact_tab_labels[i]),
                     "%s *", artifact_label(kind))
        } else {
            snprintf(artifact_tab_labels[i], sizeof(artifact_tab_labels[i]),
                     "%s", artifact_label(kind))
        }
        artifact_tabs[i].label = artifact_tab_labels[i]
        artifact_tabs[i].icon = (Texture2D){0}
        artifact_tabs[i].icon_size = 0
        artifact_tabs[i].disabled = 0
        artifact_tabs[i].accent = kind == state.IDE_ARTIFACT_KRY ?
            (Color){0} : (Color){244, 137, 61, 255}
        artifact_tabs[i].italic = kind == state.IDE_ARTIFACT_KRY ? 0 : 1
        artifact_tabs[i].closeable = 0
    }
    clicked := TabBar((TabBarProps){
        bounds, artifact_tabs, 4, f->artifact_tab,
        ScaleUIPx(12), ScaleUIPx(56), ScaleUIPx(92),
        NULL, 0, NULL, NULL
    })
    if clicked >= 0 {
        artifact_cache_store_active(f)
        f->artifact_tab = clicked
        f->focused = clicked == state.IDE_ARTIFACT_KRY ? 1 : 0
        f->artifact_focused = clicked == state.IDE_ARTIFACT_KRY ? 0 : 1
        if clicked != state.IDE_ARTIFACT_KRY {
            if artifact_cache_restore(f, clicked) == 0 {
                artifact_generate(st, f, clicked)
            }
        }
    }
}

draw_tabs :: (bounds: Rectangle, st: state.IdeState*) {
    for int i = 0; i < st->open_count; i++ {
        f := &st->open_files[i]
        if f->dirty != 0 {
            snprintf(source_tab_labels[i], sizeof(source_tab_labels[i]),
                     "%s *", f->name)
        } else {
            snprintf(source_tab_labels[i], sizeof(source_tab_labels[i]),
                     "%s", f->name)
        }
        source_tabs[i].label = source_tab_labels[i]
        source_tabs[i].icon = (Texture2D){0}
        source_tabs[i].icon_size = 0
        source_tabs[i].disabled = 0
        source_tabs[i].accent = (Color){0}
        source_tabs[i].italic = f->preview != 0 ? 1 : 0
        source_tabs[i].closeable = 1
    }

    closed := -1
    clicked := TabBar((TabBarProps){
        bounds, source_tabs, st->open_count, st->active_open,
        ScaleUIPx(13), ScaleUIPx(96), ScaleUIPx(220),
        &st->source_tab_scroll, 1, &closed, NULL
    })
    if closed >= 0 {
        st->active_open = closed
        editor_close_active(st)
        return
    }
    if clicked >= 0 {
        st->active_open = clicked
        st->open_files[clicked].focused = 1
        st->console_focused = 0
        state.project_set_status(st, st->open_files[clicked].path)
        return
    }
}

draw_editor :: (bounds: Rectangle, st: state.IdeState*) {
    if st->open_count == 0 {
        Text("Select a file from the tree",
                   (int)bounds.x + ScaleUIPx(16), (int)bounds.y + ScaleUIPx(16),
                   ScaleUIPx(15), GetThemeText())
        return
    }
    tab_h := TabBarHeight()
    tab_bounds := (Rectangle){bounds.x, bounds.y, bounds.width, (float)tab_h}
    draw_tabs(tab_bounds, st)
    body := (Rectangle){bounds.x, bounds.y + (float)tab_h,
                        bounds.width, bounds.height - (float)tab_h}
    f := state.active_file(st)
    if f == NULL {
        return
    }
    if hx.is_krb_file(f->name) != 0 {
        hx.draw_hex_editor(body, st, f)
        return
    }
    if is_kry_file(f->name) != 0 {
        artifact_bounds := (Rectangle){body.x, body.y, body.width, (float)tab_h}
        draw_artifact_tabs(artifact_bounds, st, f)
        body.y = body.y + (float)tab_h
        body.height = body.height - (float)tab_h
    } else {
        f->artifact_tab = state.IDE_ARTIFACT_KRY
    }
    editor_style := (TextInputStyle){
        GetThemeSurface(),
        GetThemeButton(),
        GetThemeLink(),
        GetThemeText(),
        GetThemeLink(),
        0,
        ScaleUIPx(14),
        ScaleUIPx(12)
    }
    artifact_style := (TextInputStyle){
        GetThemeSurface(),
        GetThemeButton(),
        (Color){244, 137, 61, 255},
        (Color){244, 137, 61, 255},
        (Color){244, 137, 61, 255},
        0,
        ScaleUIPx(14),
        ScaleUIPx(12)
    }
    if f->artifact_tab != state.IDE_ARTIFACT_KRY {
        artifact_generate(st, f, f->artifact_tab)
        before_artifact_len := f->artifact_length
        if f->artifact_tab == state.IDE_ARTIFACT_KRB {
            hx.draw_hex_artifact(body, st, f)
            f->artifact_focused = 0
            if mod_key_down() && IsKeyPressed(KEY_S) {
                hx.hex_save(st)
                editor_save_artifact(st, f)
            }
        } else {
            changed := TextArea((TextAreaProps){
                body, f->artifact_source, sizeof(f->artifact_source),
                &f->artifact_cursor, &f->artifact_focused, &f->artifact_scroll,
                sizeof(f->artifact_source) - 1, ScaleUIPx(14), ScaleUIPx(6),
                3002, "Generated", f->artifact_tab == state.IDE_ARTIFACT_C ?
                SyntaxC : SyntaxKry,
                artifact_style, (TextInputFilter){0}, NULL,
                f->artifact_content_version
            })
            after_artifact_len := (int)strlen(f->artifact_source)
            if changed != 0 || after_artifact_len != before_artifact_len {
                f->artifact_length = after_artifact_len
                artifact_mark_content_changed(f)
                f->artifact_dirty = 1
                artifact_cache_store_active(f)
            }
        }
        if f->artifact_focused != 0 {
            st->console_focused = 0
        }
        if mod_key_down() && IsKeyPressed(KEY_S) &&
           f->artifact_tab != state.IDE_ARTIFACT_KRB {
            editor_save_artifact(st, f)
        }
        return
    }
    # Undo/redo before the textarea consumes the keypress.
    if f->focused != 0 && mod_key_down() {
        if IsKeyPressed(KEY_Z) && shift_key_down() {
            editor_redo(st)
        } else if IsKeyPressed(KEY_Z) {
            editor_undo(st)
        } else if IsKeyPressed(KEY_Y) {
            editor_redo(st)
        }
    }
    if st->console_focused != 0 {
        f->focused = 0
    }
    editor_snapshot_ensure(f)
    before_len := strlen(f->source)
    text_changed := TextArea((TextAreaProps){
        body, f->source, sizeof(f->source),
        &f->cursor, &f->focused, &f->scroll,
        sizeof(f->source) - 1, ScaleUIPx(14), ScaleUIPx(6), 3001,
        "Source", mods.file_syntax(st, f->name),
        editor_style, (TextInputFilter){0}, NULL, 0
    })
    after_len := strlen(f->source)
    if f->focused != 0 {
        st->console_focused = 0
    }
    if text_changed != 0 || after_len != before_len {
        if f->snapshot_valid != 0 {
            editor_push_undo(f, f->snapshot_text, f->snapshot_cursor,
                             f->snapshot_scroll, f->snapshot_revision)
            editor_history_clear_redo(f)
        }
        f->revision = f->revision + 1
        f->dirty = f->revision != f->saved_revision ? 1 : 0
        f->preview = 0
        artifact_cache_invalidate(f)
        if mods.file_affects_preview(st, f->name) != 0 {
            st->preview_dirty = 1
            st->last_edit_time = GetTime()
        }
        editor_snapshot_capture(f)
    }
    # Ctrl/Cmd+S saves the active buffer.
    if f->focused != 0 && mod_key_down() && IsKeyPressed(KEY_S) {
        editor_save_active(st)
    }
}
