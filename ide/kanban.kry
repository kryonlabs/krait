#module "ide.kanban"
#import "kryon.h"
#import <string.h>
state :: #import "ide/state"
proj :: #import "ide/project"
dc :: #import "ide/daochi"

krait_daochi_has_account :: () -> int #extern
krait_daochi_friends_refresh :: () -> int #extern
krait_daochi_boards_refresh :: () -> int #extern
krait_github_board_sync :: () -> int #extern
krait_github_card_issue :: (col: int, index: int) -> int #extern
krait_git_status_text :: () -> const char* #extern

krait_kanban_rescan :: () -> int #extern
krait_kanban_count :: (col: int) -> int #extern
krait_kanban_column_name :: (col: int) -> const char* #extern
krait_kanban_card_id :: (col: int, index: int) -> const char* #extern
krait_kanban_card_title :: (col: int, index: int) -> const char* #extern
krait_kanban_card_project :: (col: int, index: int) -> const char* #extern
krait_kanban_card_body :: (col: int, index: int) -> const char* #extern
krait_kanban_card_path :: (col: int, index: int) -> const char* #extern
krait_kanban_card_status :: (col: int, index: int) -> const char* #extern
krait_kanban_create :: (col: int, title: const char*) -> int #extern
krait_kanban_set_title :: (col: int, index: int, title: const char*) -> int #extern
krait_kanban_set_body :: (col: int, index: int, body: const char*) -> int #extern
krait_kanban_set_project :: (col: int, index: int, project: const char*) -> int #extern
krait_kanban_move :: (col: int, index: int, to_col: int) -> int #extern
krait_kanban_delete :: (col: int, index: int) -> int #extern
krait_kanban_new_project :: (col: int, index: int, path: const char*) -> int #extern
krait_kanban_ai_configured :: () -> int #extern
krait_kanban_ai_run :: (col: int, index: int) -> int #extern
krait_kanban_ai_poll :: (col: int, index: int) -> int #extern
krait_kanban_proposal_count :: (col: int, index: int) -> int #extern
krait_kanban_proposal_path :: (col: int, index: int, file_index: int) -> const char* #extern
krait_kanban_proposal_content :: (col: int, index: int, file_index: int) -> const char* #extern
krait_kanban_apply :: (col: int, index: int) -> int #extern
krait_kanban_agent_ready :: () -> int #extern
krait_kanban_agent_bridge :: (col: int, index: int) -> int #extern
krait_ai_config_hint :: () -> const char* #extern
krait_kanban_reject :: (col: int, index: int) -> int #extern

kanban_sel_col :: int #global
kanban_sel_card :: int #global
kanban_detail_open :: int #global
kanban_detail_title :: [256] char #global
kanban_title_cursor :: int #global
kanban_title_focused :: int #global
kanban_detail_body :: [8192] char #global
kanban_body_cursor :: int #global
kanban_body_focused :: int #global
kanban_body_scroll :: int #global
kanban_ai_running :: int #global

kanban_reset_selection :: () {
    kanban_sel_col = -1
    kanban_sel_card = -1
    kanban_detail_open = 0
    kanban_ai_running = 0
}

kanban_valid_selection :: () -> int {
    if kanban_sel_col < 0 || kanban_sel_card < 0 {
        return 0
    }
    return kanban_sel_card < krait_kanban_count(kanban_sel_col)
}

kanban_open_selected :: (st: state.IdeState*) {
    if kanban_valid_selection() == 0 {
        return
    }
    path := krait_kanban_card_project(kanban_sel_col, kanban_sel_card)
    if strlen(path) == 0 {
        state.project_set_status(st, "Card has no project")
        return
    }
    proj.project_open(st, path)
}

draw_kanban :: (bounds: Rectangle, st: state.IdeState*) {
    DrawRectangleRec(bounds, GetThemeSurface())
    if krait_kanban_ai_configured() != 0 && kanban_ai_running != 0 {
        krait_kanban_ai_poll(kanban_sel_col, kanban_sel_card)
    }
    pad := ScaleUIPx(8)
    modal := 0
    if kanban_detail_open != 0 {
        if kanban_valid_selection() {
            modal = 1
        } else {
            kanban_reset_selection()
        }
    }
    draw_board(bounds, st, pad, modal)
}

draw_board :: (bounds: Rectangle, st: state.IdeState*, pad: int, modal: int) {
    row_h := ScaleUIPx(30)
    if StyledButton((int)bounds.x + pad, (int)bounds.y + ScaleUIPx(6),
                           ScaleUIPx(80), row_h, "+ Card",
                           ButtonStylePrimary, modal, NULL) {
        krait_kanban_create(0, "New card")
        krait_kanban_rescan()
    }
    if StyledButton((int)bounds.x + pad + ScaleUIPx(88),
                           (int)bounds.y + ScaleUIPx(6),
                           ScaleUIPx(110), row_h, "+ Project",
                           ButtonStylePrimary, modal, NULL) {
        st->dialog_mode = state.IDE_DIALOG_KANBAN_PROJECT
    }
    if StyledButton((int)bounds.x + pad + ScaleUIPx(206),
                           (int)bounds.y + ScaleUIPx(6),
                           ScaleUIPx(80), row_h, "Rescan",
                           ButtonStyleSecondary, modal, NULL) {
        krait_kanban_rescan()
    }
    if StyledButton((int)bounds.x + pad + ScaleUIPx(292),
                           (int)bounds.y + ScaleUIPx(6),
                           ScaleUIPx(70), row_h, "Share",
                           ButtonStyleSecondary, modal, NULL) {
        if dc.krait_daochi_has_account() != 0 {
            title: [160] char
            snprintf(title, sizeof(title), "%s", "Krait board")
            dc.daochi_share_open = 1
            dc.krait_daochi_friends_refresh()
        } else {
            state.project_set_status(st, "create a Daochi account in settings first")
        }
    }
    if StyledButton((int)bounds.x + pad + ScaleUIPx(368),
                           (int)bounds.y + ScaleUIPx(6),
                           ScaleUIPx(80), row_h, "Shared",
                           ButtonStyleSecondary, modal, NULL) {
        if dc.krait_daochi_has_account() != 0 {
            dc.krait_daochi_boards_refresh()
            dc.daochi_shared_open = 1
        }
    }
    if StyledButton((int)bounds.x + pad + ScaleUIPx(454),
                           (int)bounds.y + ScaleUIPx(6),
                           ScaleUIPx(90), row_h, "GitHub",
                           ButtonStyleSecondary, modal, NULL) {
        state.project_set_status(st, "syncing kanban with github...")
        if krait_github_board_sync() != 0 {
            state.project_set_status(st, krait_git_status_text())
            krait_kanban_rescan()
        } else {
            state.project_set_status(st, krait_git_status_text())
        }
    }
    if krait_kanban_ai_configured() == 0 {
        Text(krait_ai_config_hint(), (int)bounds.x + pad,
                   (int)bounds.y + row_h + ScaleUIPx(12), ScaleUIPx(11),
                   GetThemeIcon())
    }

    top := (int)bounds.y + row_h + ScaleUIPx(24)
    gap := ScaleUIPx(8)
    col_w := (bounds.width - (float)(pad * 2 + gap * 3)) / 4.0
    col := 0
    while col < 4 {
        x := bounds.x + (float)pad + (col_w + (float)gap) * (float)col
        col_bounds := (Rectangle){x, (float)top, col_w,
                                  bounds.height - (float)(top - (int)bounds.y)}
        draw_column(col_bounds, col, 1 - modal)
        col = col + 1
    }
}

draw_column :: (bounds: Rectangle, col: int, interactive: int) {
    DrawRectangleRec(bounds, GetThemeBackground())
    DrawRectangleLinesEx(bounds, 1, GetThemeButton())
    header: [64] char
    snprintf(header, sizeof(header), "%s (%d)",
             krait_kanban_column_name(col), krait_kanban_count(col))
    Text(header, (int)bounds.x + ScaleUIPx(8),
               (int)bounds.y + ScaleUIPx(6), ScaleUIPx(12), GetThemeText())
    count := krait_kanban_count(col)
    card_h := ScaleUIPx(56)
    y := (int)bounds.y + ScaleUIPx(26)
    i := 0
    while i < count {
        row := (Rectangle){bounds.x + ScaleUIPx(4), (float)y,
                            bounds.width - ScaleUIPx(8), (float)card_h}
        if y + card_h > (int)bounds.y + (int)bounds.height {
            break
        }
        DrawRectangleRec(row, GetThemeSurface())
        DrawRectangleLinesEx(row, 1, GetThemeButton())
        title := krait_kanban_card_title(col, i)
        BeginScissorMode((int)row.x, (int)row.y, (int)row.width, (int)row.height)
        Text(title, (int)row.x + ScaleUIPx(6),
                   (int)row.y + ScaleUIPx(6), ScaleUIPx(12), GetThemeText())
        project := krait_kanban_card_project(col, i)
        if strlen(project) > 0 {
            Text(project, (int)row.x + ScaleUIPx(6),
                       (int)row.y + ScaleUIPx(22), ScaleUIPx(10),
                       GetThemeLink())
        }
        status := krait_kanban_card_status(col, i)
        if strlen(status) > 0 {
            Text(status, (int)row.x + ScaleUIPx(6),
                       (int)row.y + ScaleUIPx(38), ScaleUIPx(10),
                       GetThemeLink())
        }
        EndScissorMode()
        if interactive != 0 &&
           CheckCollisionPointRec(GetMousePosition(), row) &&
           IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
            kanban_sel_col = col
            kanban_sel_card = i
            kanban_detail_open = 1
            snprintf(kanban_detail_title, sizeof(kanban_detail_title), "%s",
                     title)
            snprintf(kanban_detail_body, sizeof(kanban_detail_body), "%s",
                     krait_kanban_card_body(col, i))
            kanban_body_cursor = 0
            kanban_body_focused = 0
            kanban_body_scroll = 0
        }
        y = y + card_h + ScaleUIPx(4)
        i = i + 1
    }
}

draw_card_modal :: (bounds: Rectangle, st: state.IdeState*) {
    w := (int)bounds.width - ScaleUIPx(160)
    if w > ScaleUIPx(760) {
        w = ScaleUIPx(760)
    }
    if w < ScaleUIPx(360) {
        w = ScaleUIPx(360)
    }
    h := (int)bounds.height - ScaleUIPx(120)
    if h > ScaleUIPx(640) {
        h = ScaleUIPx(640)
    }
    if h < ScaleUIPx(420) {
        h = ScaleUIPx(420)
    }
    frame := ModalFrame(w, h, kanban_detail_title,
                        (Texture2D){0}, (Texture2D){0})
    if IsKeyPressed(KEY_ESCAPE) ||
       (IsMouseButtonPressed(MOUSE_BUTTON_LEFT) &&
        !CheckCollisionPointRec(GetMousePosition(),
                                (Rectangle){(float)frame.x, (float)frame.y,
                                            (float)frame.w, (float)frame.h})) {
        kanban_reset_selection()
        return
    }
    panel := (Rectangle){(float)frame.content_x, (float)frame.content_y,
                         (float)frame.content_w, (float)frame.content_h}
    draw_card_detail(panel, st, ScaleUIPx(8))
}

draw_card_detail :: (bounds: Rectangle, st: state.IdeState*, pad: int) {
    col := kanban_sel_col
    index := kanban_sel_card
    row_h := ScaleUIPx(30)
    if StyledButton((int)bounds.x + pad, (int)bounds.y + ScaleUIPx(6),
                           ScaleUIPx(60), row_h, "Close",
                           ButtonStyleSecondary, 0, NULL) {
        kanban_reset_selection()
        return
    }
    column_label: [64] char
    snprintf(column_label, sizeof(column_label), "%s",
             krait_kanban_column_name(col))
    Text(column_label, (int)bounds.x + ScaleUIPx(190),
               (int)bounds.y + ScaleUIPx(13), ScaleUIPx(12), GetThemeIcon())
    if col > 0 {
        if StyledButton((int)bounds.x + pad + ScaleUIPx(72),
                               (int)bounds.y + ScaleUIPx(6),
                               ScaleUIPx(28), row_h, "<",
                               ButtonStyleSecondary, 0, NULL) {
            krait_kanban_move(col, index, col - 1)
            kanban_reset_selection()
            return
        }
    }
    if col < 3 {
        if StyledButton((int)bounds.x + pad + ScaleUIPx(104),
                               (int)bounds.y + ScaleUIPx(6),
                               col == 2 ? ScaleUIPx(70) : ScaleUIPx(28), row_h, col == 2 ? "Accept" : ">",
                               ButtonStyleSecondary, 0, NULL) {
            if krait_kanban_move(col, index, col + 1) == 0 {
                return
            }
            kanban_reset_selection()
            return
        }
    }
    if StyledButton((int)bounds.x + (int)bounds.width - pad - ScaleUIPx(60),
                           (int)bounds.y + ScaleUIPx(6),
                           ScaleUIPx(60), row_h, "Delete",
                           ButtonStyleSecondary, 0, NULL) {
        krait_kanban_delete(col, index)
        kanban_reset_selection()
        return
    }

    body_top := (int)bounds.y + row_h + ScaleUIPx(18)
    input_style := (TextInputStyle){
        GetThemeSurface(), GetThemeButton(), GetThemeLink(), GetThemeText(),
        GetThemeText(), 0, ScaleUIPx(10), ScaleUIPx(8)
    }
    old_len := strlen(kanban_detail_title)
    TextField((TextFieldProps){
        (Rectangle){bounds.x + (float)pad, (float)body_top,
                    bounds.width - (float)(pad * 2), (float)row_h},
        kanban_detail_title, sizeof(kanban_detail_title),
        &kanban_title_cursor, &kanban_title_focused,
        sizeof(kanban_detail_title) - 1, ScaleUIPx(13), 7501,
        input_style, (TextInputFilter){0}, NULL, NULL
    })
    if strlen(kanban_detail_title) != old_len {
        krait_kanban_set_title(col, index, kanban_detail_title)
    }

    project := krait_kanban_card_project(col, index)
    proj_line: [1280] char
    if strlen(project) > 0 {
        snprintf(proj_line, sizeof(proj_line), "project: %s", project)
    } else {
        snprintf(proj_line, sizeof(proj_line), "no project bound")
    }
    issue_no := krait_github_card_issue(col, index)
    if issue_no > 0 {
        snprintf(proj_line + strlen(proj_line),
                 sizeof(proj_line) - strlen(proj_line),
                 "   github #%d", issue_no)
    }
    Text(proj_line, (int)bounds.x + pad,
               body_top + row_h + ScaleUIPx(10), ScaleUIPx(11), GetThemeLink())

    ai_state := krait_kanban_ai_poll(col, index)
    status := krait_kanban_card_status(col, index)
    if strlen(status) > 0 {
        Text(status, (int)bounds.x + (int)bounds.width - pad - ScaleUIPx(320),
                   body_top + ScaleUIPx(6), ScaleUIPx(11), GetThemeLink())
    }

    btn_y := (int)bounds.y + (int)bounds.height - row_h - ScaleUIPx(10)
    mid_top := body_top + row_h + ScaleUIPx(26)
    mid_bottom := btn_y - ScaleUIPx(10)
    proposals := krait_kanban_proposal_count(col, index)
    area_h := mid_bottom - mid_top
    if proposals > 0 {
        area_h = (mid_bottom - mid_top) * 55 / 100
    }
    old_body_len := strlen(kanban_detail_body)
    body_changed := TextArea((TextAreaProps){
        (Rectangle){bounds.x + (float)pad, (float)mid_top,
                    bounds.width - (float)(pad * 2), (float)area_h},
        kanban_detail_body, sizeof(kanban_detail_body),
        &kanban_body_cursor, &kanban_body_focused, &kanban_body_scroll,
        sizeof(kanban_detail_body) - 1, ScaleUIPx(13), ScaleUIPx(6), 7502,
        "Card prompt / notes", SyntaxNone,
        input_style, (TextInputFilter){0}, NULL, 0
    })
    if body_changed != 0 || strlen(kanban_detail_body) != old_body_len {
        krait_kanban_set_body(col, index, kanban_detail_body)
    }

    if proposals > 0 {
        p := 0
        py := mid_top + area_h + ScaleUIPx(12)
        while p < proposals && py + ScaleUIPx(104) < btn_y {
            path := krait_kanban_proposal_path(col, index, p)
            label: [300] char
            snprintf(label, sizeof(label), "proposed: %s", path)
            Text(label, (int)bounds.x + pad, py, ScaleUIPx(11),
                       GetThemeText())
            content := krait_kanban_proposal_content(col, index, p)
            preview := (Rectangle){bounds.x + (float)pad, (float)py + ScaleUIPx(14),
                                   bounds.width - (float)(pad * 2), ScaleUIPx(84)}
            DrawRectangleRec(preview, GetThemeSurface())
            DrawRectangleLinesEx(preview, 1, GetThemeButton())
            BeginScissorMode((int)preview.x, (int)preview.y,
                             (int)preview.width, (int)preview.height)
            Text(content, (int)preview.x + ScaleUIPx(6),
                       (int)preview.y + ScaleUIPx(4), ScaleUIPx(11),
                       GetThemeText())
            EndScissorMode()
            py = py + ScaleUIPx(104)
            p = p + 1
        }
    }

    if strlen(project) > 0 {
        if StyledButton((int)bounds.x + pad, btn_y, ScaleUIPx(70),
                               row_h, "Open",
                               ButtonStylePrimary, 0, NULL) {
            kanban_open_selected(st)
        }
    }
    if krait_kanban_agent_ready() != 0 {
        if StyledButton((int)bounds.x + pad + ScaleUIPx(78), btn_y,
                               ScaleUIPx(110), row_h, "Run in Agent",
                               ButtonStylePrimary, 0, NULL) {
            krait_kanban_agent_bridge(kanban_sel_col, kanban_sel_card)
            kanban_reset_selection()
            st->view = state.IDE_VIEW_AGENT
        }
    }
    if krait_kanban_ai_configured() != 0 {
        if StyledButton((int)bounds.x + pad + ScaleUIPx(78), btn_y,
                               ScaleUIPx(80), row_h, "Run AI",
                               ButtonStylePrimary, 0, NULL) {
            krait_kanban_ai_run(col, index)
            kanban_ai_running = 1
        }
    } else {
        Text(krait_ai_config_hint(), (int)bounds.x + pad + ScaleUIPx(78),
                   btn_y + ScaleUIPx(9), ScaleUIPx(11), GetThemeIcon())
    }
    if proposals > 0 {
        if StyledButton((int)bounds.x + pad + ScaleUIPx(164), btn_y,
                               ScaleUIPx(80), row_h, "Apply",
                               ButtonStylePrimary, 0, NULL) {
            applied := krait_kanban_apply(col, index)
            if applied > 0 {
                state.project_set_status(st, "AI proposal applied")
            }
        }
        if StyledButton((int)bounds.x + pad + ScaleUIPx(252), btn_y,
                               ScaleUIPx(80), row_h, "Reject",
                               ButtonStyleSecondary, 0, NULL) {
            krait_kanban_reject(col, index)
        }
    }
}
