#module "hello"
#import "kryon.h"

app "Hello KITE" {
    size 640 360
    fps 60
    frame frame
}

frame :: () {
    BeginDrawing()
    ClearBackground(GetThemeBackground())
    BeginUIFrame(GetScreenWidth(), GetScreenHeight(), GetUIScale())
    DrawText("Hello from KITE", ScaleUIPx(32), ScaleUIPx(32),
             ScaleUIPx(24), GetThemeText())
    EndUIFocus()
    EndDrawing()
}
